---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const tutteLeFoto = await getCollection('voglioLiveFoto');

const foto = tutteLeFoto
  .sort((a, b) => {
    if (b.data.anno !== a.data.anno) return b.data.anno - a.data.anno;
    return (a.data.ordine ?? 0) - (b.data.ordine ?? 0);
  })
  .map(f => ({
    src: f.data.immagine,
    alt: f.data.didascalia,
    anno: f.data.anno,
  }));

const ANNI = [...new Set(foto.map(f => f.anno))];

// Raggruppa le foto per anno, mantenendo l'ordine (più recente per primo).
const gruppi = ANNI.map(anno => ({
  anno,
  foto: foto.filter(f => f.anno === anno),
}));
---

<BaseLayout title="Foto di Voglio Live — Jam Session APS" description="Le fotografie delle passate edizioni di Voglio Live, il festival delle scuole di musica che dal 2019 porta la musica in piazza.">
  <Header />
  <div class="container">
    <main class="page-content">
      <p class="kicker"><a href="/eventi/voglio-live-2027">← Voglio Live 2027</a></p>
      <h1>Le foto di Voglio Live</h1>
      <p class="lead">
        Le immagini delle edizioni passate del festival, da Pian del Voglio a Piazza Lucio Dalla.
      </p>

      {gruppi.length > 0 ? (
        gruppi.map(gruppo => (
          <section class="anno-section" aria-label={`Edizione ${gruppo.anno}`}>
            <h2>{gruppo.anno}</h2>
            <div class="foto-grid">
              {gruppo.foto.map((f, i) => (
                <figure class="foto-item">
                  <button
                    type="button"
                    class="foto-photo"
                    data-src={f.src}
                    data-alt={f.alt}
                    aria-label={`Apri la foto: ${f.alt}`}
                  >
                    <img src={f.src} alt={f.alt} loading="lazy" />
                  </button>
                  <figcaption>{f.alt}</figcaption>
                </figure>
              ))}
            </div>
          </section>
        ))
      ) : (
        <div class="empty-state">
          <p>Le foto delle edizioni passate arriveranno presto.</p>
        </div>
      )}

    </main>
    <Footer />
  </div>

  <div class="lightbox" role="dialog" aria-modal="true" aria-label="Foto ingrandita">
    <button type="button" class="lightbox-close" aria-label="Chiudi">✕</button>
    <button type="button" class="lightbox-prev" aria-label="Foto precedente">‹</button>
    <img class="lightbox-img" src="" alt="" />
    <button type="button" class="lightbox-next" aria-label="Foto successiva">›</button>
  </div>
</BaseLayout>

<script>
  const items = Array.from(document.querySelectorAll<HTMLButtonElement>('.foto-photo'));
  const lightbox = document.querySelector<HTMLDivElement>('.lightbox');
  const lightboxImg = document.querySelector<HTMLImageElement>('.lightbox-img');
  let current = -1;

  function apri(index: number) {
    if (!items[index] || !lightbox || !lightboxImg) return;
    current = index;
    lightboxImg.src = items[index].dataset.src ?? '';
    lightboxImg.alt = items[index].dataset.alt ?? '';
    lightbox.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function chiudi() {
    lightbox?.classList.remove('open');
    document.body.style.overflow = '';
  }

  function vai(delta: number) {
    if (current < 0) return;
    const next = (current + delta + items.length) % items.length;
    apri(next);
  }

  items.forEach((item, i) => {
    item.addEventListener('click', () => apri(i));
  });

  document.querySelector('.lightbox-close')?.addEventListener('click', chiudi);
  document.querySelector('.lightbox-prev')?.addEventListener('click', () => vai(-1));
  document.querySelector('.lightbox-next')?.addEventListener('click', () => vai(1));

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) chiudi();
  });

  document.addEventListener('keydown', (e) => {
    if (!lightbox?.classList.contains('open')) return;
    if (e.key === 'Escape') chiudi();
    if (e.key === 'ArrowLeft') vai(-1);
    if (e.key === 'ArrowRight') vai(1);
  });
</script>

<style>
  :root {
    --green: #0f5f53;
    --accent: #f2a844;
    --ink: #0b0b0b;
    --surface: #f2f4f3;
    --radiusLg: 28px;
    --radius: 18px;
    --shadow: 0 12px 28px rgba(0,0,0,.08);
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: "Lexend", system-ui, sans-serif; color: var(--ink); background: #fff; }
  a { color: inherit; }

  .container { width: min(1120px, calc(100% - 32px)); margin: 0 auto; padding: 14px 0 90px; }
  .page-content { margin: 16px 0 60px; }
  .kicker { font-family: "Inter", sans-serif; font-weight: 800; font-size: 13px; margin: 0 0 10px; }
  .kicker a { color: var(--green); text-decoration: none; }
  .kicker a:hover { text-decoration: underline; }
  .page-content h1 {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: clamp(32px, 4.4vw, 44px);
    margin: 0 0 14px;
  }
  .lead {
    font-family: "Lexend", sans-serif;
    font-size: 19px;
    line-height: 1.6;
    opacity: .82;
    margin: 0 0 40px;
    max-width: 640px;
  }

  .anno-section { margin-top: 44px; }
  .anno-section:first-of-type { margin-top: 0; }
  .anno-section h2 {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 22px;
    letter-spacing: -.25px;
    margin: 0 0 18px;
  }

  .foto-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  @media (min-width: 640px) {
    .foto-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 980px) {
    .foto-grid { grid-template-columns: repeat(4, 1fr); }
  }
  .foto-item { margin: 0; }
  .foto-photo {
    display: block;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    aspect-ratio: 4 / 3;
  }
  .foto-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform .25s ease;
  }
  .foto-photo:hover img { transform: scale(1.04); }
  .foto-item figcaption {
    margin-top: 8px;
    font-family: "Lexend", sans-serif;
    font-size: 13px;
    opacity: .68;
  }

  .empty-state {
    background: var(--surface);
    border-radius: var(--radiusLg);
    padding: 56px 32px;
    text-align: center;
  }
  .empty-state p {
    font-family: "Lexend", sans-serif;
    opacity: .74;
    font-size: 17px;
    margin: 0;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1200;
    background: rgba(11,11,11,.85);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 60px 16px;
  }
  .lightbox.open { display: flex; }
  .lightbox-img {
    max-width: min(1000px, 100%);
    max-height: 100%;
    border-radius: 12px;
    box-shadow: 0 24px 60px rgba(0,0,0,.4);
  }
  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: fixed;
    background: rgba(255,255,255,.12);
    color: #fff;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    font-size: 20px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox-close:hover,
  .lightbox-prev:hover,
  .lightbox-next:hover { background: rgba(255,255,255,.24); }
  .lightbox-close { top: 20px; right: 20px; width: 44px; height: 44px; }
  .lightbox-prev,
  .lightbox-next {
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
    font-size: 28px;
  }
  .lightbox-prev { left: 12px; }
  .lightbox-next { right: 12px; }
  @media (min-width: 640px) {
    .lightbox-prev { left: 24px; }
    .lightbox-next { right: 24px; }
  }
</style>
