---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const TIPO_LABEL: Record<string, string> = {
  masterclass: "Masterclass",
  workshop: "Workshop",
  live: "Live",
  festival: "Festival",
};
const ORDINE_TIPI = ["masterclass", "workshop", "live", "festival"];

// L'associazione ragiona per anno sociale (es. "2026/2027", da settembre ad agosto),
// non per anno solare: il raggruppamento sotto segue lo stesso criterio delle news.
function annoSociale(d: Date) {
  const y = d.getFullYear();
  return d.getMonth() >= 8 ? `${y}/${y + 1}` : `${y - 1}/${y}`;
}

const oggiStr = new Date().toISOString().slice(0, 10);
const tuttiEventi = await getCollection('eventi');

const archivio = tuttiEventi
  .filter(e => e.data.data < oggiStr)
  .sort((a, b) => (a.data.data < b.data.data ? 1 : -1))
  .map(e => {
    const d = new Date(e.data.data);
    return {
      nome: e.data.nome,
      tipo: e.data.tipo,
      tipoLabel: TIPO_LABEL[e.data.tipo],
      dataDisplay: d.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' }),
      teaser: e.data.teaser,
      ospiti: e.data.ospiti,
      href: e.data.href,
      video: e.data.video,
      immagine: e.data.immagine,
      vetrina: e.data.vetrina,
      annoSociale: annoSociale(d),
    };
  });

const TIPI_PRESENTI = ORDINE_TIPI.filter(t => archivio.some(e => e.tipo === t));
const ANNI_SOCIALI = [...new Set(archivio.map(e => e.annoSociale))].sort((a, b) => b.localeCompare(a));
const inVetrina = archivio.filter(e => e.vetrina).slice(0, 4);
---

<BaseLayout title="Eventi passati — Jam Session APS" description="L'archivio delle masterclass, dei workshop e dei concerti che Jam Session APS ha realizzato nel tempo.">
  <Header />
  <div class="container">
    <main class="page-content">
      <p class="kicker"><a href="/eventi">← Tutti gli eventi</a></p>
      <h1>Eventi passati</h1>
      <p class="lead">Qui raccogliamo le masterclass, i workshop e i concerti che Jam Session ha realizzato nel tempo.</p>

      {inVetrina.length > 0 && (
        <section class="vetrina-section" aria-label="Eventi in vetrina">
          <h2>In vetrina</h2>
          <div class="eventi-grid">
            {inVetrina.map(e => (
              <div class="evento-card" data-tipo={e.tipo}>
                {e.immagine && (
                  <div class="evento-foto">
                    <img src={e.immagine} alt={e.nome} loading="lazy" />
                  </div>
                )}
                <div class="evento-corpo">
                  <span class="evento-tipo">{e.tipoLabel}</span>
                  <span class="evento-data">{e.dataDisplay}</span>
                  <span class="evento-nome">{e.nome}</span>
                  <p class="evento-teaser">{e.teaser}</p>
                  {e.ospiti && e.ospiti.length > 0 && <p class="evento-ospiti">Con {e.ospiti.join(', ')}</p>}
                  <div class="evento-links">
                    {e.href && <a class="evento-link" href={e.href}>Scopri di più →</a>}
                    {e.video && <a class="evento-link" href={e.video} target="_blank" rel="noopener">Guarda il video →</a>}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      {archivio.length > 0 ? (
        <>
          {TIPI_PRESENTI.length > 1 && (
            <div class="filtri" role="group" aria-label="Filtra per tipo di evento">
              <button type="button" class="filtro-btn is-active" data-filter="tutti">Tutti</button>
              {TIPI_PRESENTI.map(t => (
                <button type="button" class="filtro-btn" data-filter={t}>{TIPO_LABEL[t]}</button>
              ))}
            </div>
          )}

          {ANNI_SOCIALI.map(anno => (
            <section class="anno-section" aria-label={`Anno sociale ${anno}`}>
              <h2>{anno}</h2>
              <div class="eventi-grid">
                {archivio.filter(e => e.annoSociale === anno).map(e => (
                  <div class="evento-card" data-tipo={e.tipo}>
                    {e.immagine && (
                      <div class="evento-foto">
                        <img src={e.immagine} alt={e.nome} loading="lazy" />
                      </div>
                    )}
                    <div class="evento-corpo">
                      <span class="evento-tipo">{e.tipoLabel}</span>
                      <span class="evento-data">{e.dataDisplay}</span>
                      <span class="evento-nome">{e.nome}</span>
                      <p class="evento-teaser">{e.teaser}</p>
                      {e.ospiti && e.ospiti.length > 0 && <p class="evento-ospiti">Con {e.ospiti.join(', ')}</p>}
                      <div class="evento-links">
                        {e.href && <a class="evento-link" href={e.href}>Scopri di più →</a>}
                        {e.video && <a class="evento-link" href={e.video} target="_blank" rel="noopener">Guarda il video →</a>}
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          ))}
        </>
      ) : (
        <div class="empty-state">
          <p>Stiamo raccogliendo l'archivio degli eventi passati: a breve qui troverai masterclass, workshop e concerti realizzati negli anni.</p>
          <a class="btn btn-outline-dark" href="/eventi">Vedi gli eventi in programma →</a>
        </div>
      )}

    </main>
    <Footer />
  </div>
</BaseLayout>

<script>
  const bottoni = Array.from(document.querySelectorAll<HTMLButtonElement>('.filtro-btn'));
  const schede = Array.from(document.querySelectorAll<HTMLDivElement>('.anno-section .evento-card'));
  const sezioni = Array.from(document.querySelectorAll<HTMLElement>('.anno-section'));

  function applica(filtro: string) {
    schede.forEach(s => {
      const match = filtro === 'tutti' || s.dataset.tipo === filtro;
      s.hidden = !match;
    });
    sezioni.forEach(sec => {
      const visibili = Array.from(sec.querySelectorAll<HTMLDivElement>('.evento-card')).some(s => !s.hidden);
      sec.hidden = !visibili;
    });
  }

  bottoni.forEach(b => {
    b.addEventListener('click', () => {
      bottoni.forEach(x => x.classList.remove('is-active'));
      b.classList.add('is-active');
      applica(b.dataset.filter ?? 'tutti');
    });
  });
</script>

<style>
  :root {
    --green: #0f5f53;
    --ink: #0b0b0b;
    --surface: #f2f4f3;
    --radius: 18px;
    --radiusLg: 28px;
    --shadow: 0 12px 28px rgba(0,0,0,.08);
    --border: 1px solid rgba(11,11,11,.18);
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: "Lexend", system-ui, sans-serif; color: var(--ink); background: #fff; }
  a { color: inherit; }

  .container { width: min(1120px, calc(100% - 32px)); margin: 0 auto; padding: 14px 0 90px; }
  .page-content { margin: 16px 0 60px; }
  .kicker { font-family: "Inter", sans-serif; font-weight: 800; font-size: 13px; margin: 0 0 10px; }
  .kicker a { color: var(--green); text-decoration: none; }
  .kicker a:hover { text-decoration: underline; }
  .page-content h1 {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: clamp(32px, 4.4vw, 44px);
    margin: 0 0 14px;
  }
  .lead {
    font-family: "Lexend", sans-serif;
    font-size: 19px;
    line-height: 1.6;
    opacity: .82;
    margin: 0 0 32px;
  }

  .filtri {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 40px;
  }
  .filtro-btn {
    font-family: "Inter", sans-serif;
    font-weight: 800;
    font-size: 13px;
    padding: 10px 18px;
    border-radius: 999px;
    border: var(--border);
    background: #fff;
    color: var(--ink);
    cursor: pointer;
  }
  .filtro-btn.is-active { background: var(--ink); color: #fff; border-color: var(--ink); }

  .vetrina-section { margin-bottom: 48px; }
  .vetrina-section h2 {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 22px;
    margin: 0 0 18px;
  }

  .anno-section { margin-top: 48px; }
  .anno-section:first-of-type { margin-top: 0; }
  .anno-section h2 {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 22px;
    margin: 0 0 18px;
  }

  .eventi-grid { display: grid; grid-template-columns: 1fr; gap: 18px; }
  @media (min-width: 560px) { .eventi-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 860px) { .eventi-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1100px) { .eventi-grid { grid-template-columns: repeat(4, 1fr); } }
  .evento-card {
    background: #fff;
    border-radius: var(--radius);
    border: 1px solid rgba(11,11,11,.1);
    box-shadow: var(--shadow);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .evento-foto {
    width: 100%;
    aspect-ratio: 3 / 4;
  }
  .evento-foto img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .evento-corpo {
    padding: 26px;
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
  }
  .evento-tipo {
    display: inline-block;
    align-self: flex-start;
    font-family: "Inter", sans-serif;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: .3px;
    text-transform: uppercase;
    color: var(--green);
    background: var(--surface);
    border-radius: 999px;
    padding: 4px 10px;
    margin: 0 0 10px;
  }
  .evento-data { display: block; font-family: "Inter", sans-serif; font-weight: 800; font-size: 12px; opacity: .6; }
  .evento-nome { display: block; font-family: "Inter", sans-serif; font-weight: 900; font-size: 20px; margin: 8px 0 12px; }
  .evento-teaser { font-family: "Lexend", sans-serif; font-size: 15px; line-height: 1.6; opacity: .76; margin: 0 0 8px; }
  .evento-ospiti {
    font-family: "Lexend", sans-serif;
    font-size: 13px;
    font-style: italic;
    opacity: .65;
    margin: 0 0 8px;
  }
  .evento-links {
    margin-top: auto;
    padding-top: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    align-items: flex-start;
  }
  .evento-link {
    font-family: "Inter", sans-serif;
    font-weight: 800;
    font-size: 13px;
    color: var(--green);
    text-decoration: none;
  }
  .evento-link:hover { text-decoration: underline; }

  .empty-state {
    background: var(--surface);
    border-radius: var(--radiusLg);
    padding: 56px 32px;
    text-align: center;
  }
  .empty-state p {
    font-family: "Lexend", sans-serif;
    opacity: .74;
    font-size: 17px;
    margin: 0 0 22px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    border-radius: 999px;
    font-family: "Inter", sans-serif;
    font-weight: 900;
    border: var(--border);
    box-shadow: var(--shadow);
    text-decoration: none;
  }
  .btn-outline-dark { background: #fff; color: var(--ink); }
</style>
