---
import BaseLayout from '../../layouts/layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Quando un evento (masterclass, workshop, concerto...) si conclude, aggiungilo qui.
const EVENTI_PASSATI: { nome: string; data: string; tipo: string; teaser: string; href?: string }[] = [];
---

<BaseLayout title="Eventi passati — Jam Session APS" description="L'archivio delle masterclass, dei workshop e dei concerti che Jam Session APS ha realizzato nel tempo.">
  <Header />
  <div class="container">
    <main class="page-content">
      <p class="kicker"><a href="/eventi">← Tutti gli eventi</a></p>
      <h1>Eventi passati</h1>
      <p class="lead">Qui raccogliamo le masterclass, i workshop e i concerti che Jam Session ha realizzato nel tempo.</p>

      {EVENTI_PASSATI.length > 0 ? (
        <div class="eventi-grid">
          {EVENTI_PASSATI.map(e => (
            <div class="evento-card">
              <span class="evento-tipo">{e.tipo}</span>
              <span class="evento-data">{e.data}</span>
              <span class="evento-nome">{e.nome}</span>
              <p class="evento-teaser">{e.teaser}</p>
            </div>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>Stiamo raccogliendo l'archivio degli eventi passati: a breve qui troverai masterclass, workshop e concerti realizzati negli anni.</p>
          <a class="btn btn-outline-dark" href="/eventi">Vedi gli eventi in programma →</a>
        </div>
      )}

    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  :root {
    --green: #0f5f53;
    --ink: #0b0b0b;
    --surface: #f2f4f3;
    --radius: 18px;
    --radiusLg: 28px;
    --shadow: 0 12px 28px rgba(0,0,0,.08);
    --border: 1px solid rgba(11,11,11,.18);
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: "Lexend", system-ui, sans-serif; color: var(--ink); background: #fff; }
  a { color: inherit; }

  .container { width: min(1120px, calc(100% - 32px)); margin: 0 auto; padding: 14px 0 90px; }
  .page-content { margin: 16px 0 60px; }
  .kicker { font-family: "Inter", sans-serif; font-weight: 800; font-size: 13px; margin: 0 0 10px; }
  .kicker a { color: var(--green); text-decoration: none; }
  .kicker a:hover { text-decoration: underline; }
  .page-content h1 {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: clamp(32px, 4.4vw, 44px);
    margin: 0 0 14px;
  }
  .lead {
    font-family: "Lexend", sans-serif;
    font-size: 19px;
    line-height: 1.6;
    opacity: .82;
    margin: 0 0 40px;
  }

  .eventi-grid { display: grid; grid-template-columns: 1fr; gap: 18px; }
  @media (min-width: 640px) { .eventi-grid { grid-template-columns: repeat(2, 1fr); } }
  .evento-card {
    background: #fff;
    border-radius: var(--radius);
    border: 1px solid rgba(11,11,11,.1);
    box-shadow: var(--shadow);
    padding: 26px;
  }
  .evento-tipo {
    display: inline-block;
    font-family: "Inter", sans-serif;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: .3px;
    text-transform: uppercase;
    color: var(--green);
    background: var(--surface);
    border-radius: 999px;
    padding: 4px 10px;
    margin: 0 0 10px;
  }
  .evento-data { display: block; font-family: "Inter", sans-serif; font-weight: 800; font-size: 12px; opacity: .6; }
  .evento-nome { display: block; font-family: "Inter", sans-serif; font-weight: 900; font-size: 20px; margin: 8px 0 12px; }
  .evento-teaser { font-family: "Lexend", sans-serif; font-size: 15px; line-height: 1.6; opacity: .76; margin: 0; }

  .empty-state {
    background: var(--surface);
    border-radius: var(--radiusLg);
    padding: 56px 32px;
    text-align: center;
  }
  .empty-state p {
    font-family: "Lexend", sans-serif;
    opacity: .74;
    font-size: 17px;
    margin: 0 0 22px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    border-radius: 999px;
    font-family: "Inter", sans-serif;
    font-weight: 900;
    border: var(--border);
    box-shadow: var(--shadow);
    text-decoration: none;
  }
  .btn-outline-dark { background: #fff; color: var(--ink); }
</style>
