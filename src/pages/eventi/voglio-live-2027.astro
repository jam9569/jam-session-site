---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// Un piccolo assaggio delle foto delle edizioni passate: l'archivio completo, per anno, è su
// /eventi/voglio-live-foto — per aggiungere altre foto basta un nuovo file in
// src/content/voglio-live-foto, non serve toccare questa pagina.
const tutteLeFoto = await getCollection('voglioLiveFoto');
const ANTEPRIMA = tutteLeFoto
  .sort((a, b) => {
    if (b.data.anno !== a.data.anno) return b.data.anno - a.data.anno;
    return (a.data.ordine ?? 0) - (b.data.ordine ?? 0);
  })
  .slice(0, 3)
  .map(f => ({ src: f.data.immagine, alt: f.data.didascalia }));
---

<BaseLayout title="Voglio Live 2027 — Jam Session APS" description="Voglio Live: il festival delle scuole di musica nato nel 2019 a Pian del Voglio, oggi anche la restituzione pubblica dei laboratori di Musica e Società. Sabato 29 maggio 2027, Piazza Lucio Dalla, Bologna.">
  <Header />
  <div class="container">
    <div class="hero-media">
      <img src="/assets/eventi/voglio-live/voglio-live-2027-hero.jpg" alt="Lo staff di Jam Session APS sul palco di Voglio Live" />
    </div>
    <p class="hero-caption">Lo Staff Jam Session</p>
    <main class="page-content">
      <p class="kicker"><a href="/eventi">← Tutti gli eventi</a></p>
      <h1>Voglio Live 2027</h1>
      <p class="lead">Il festival delle scuole di musica diventato anche la restituzione pubblica dei laboratori di Musica e Società: un pomeriggio di musica dal vivo in Piazza Lucio Dalla.</p>

      <div class="info-pratiche" aria-label="Informazioni pratiche">
        <div class="info-item">
          <span class="info-label">Quando</span>
          <span class="info-value">Sabato 29 maggio 2027</span>
        </div>
        <div class="info-item">
          <span class="info-label">Dove</span>
          <span class="info-value">Piazza Lucio Dalla, Bologna</span>
        </div>
        <div class="info-item">
          <span class="info-label">Progetto</span>
          <span class="info-value"><a href="/progetti/musica-e-societa">Musica e Società</a></span>
        </div>
      </div>

      <div class="testo-intro">
        <p>
          Voglio Live nasce nel 2019 a Pian del Voglio come festival delle scuole di musica: un palco su
          cui salgono i gruppi di musica d'insieme nati nei corsi e nei laboratori delle scuole partner —
          non singoli allievi, ma formazioni che suonano insieme. Da allora non si è mai fermato, nemmeno
          negli anni della pandemia.
        </p>
        <p>
          Dal 2026 il festival si è trasferito a Bologna, in Piazza Lucio Dalla, dove torna anche nel 2027.
          Con il cambio di sede è arrivata anche una nuova identità: Voglio Live resta il palco delle scuole
          di musica partner, che continuano a portare i propri allievi, ma è diventato anche la restituzione
          pubblica dei laboratori di{" "}<a href="/progetti/musica-e-societa">Musica e Società</a>, la rete
          regionale di educazione musicale che Jam Session APS coordina come soggetto capofila in sei
          province dell'Emilia-Romagna: cori, ensemble e gruppi nati nei laboratori di canto corale,
          propedeutica musicale e musica d'insieme portati avanti durante l'anno nelle scuole — soprattutto
          superiori — della rete.
        </p>
        <p>
          L'edizione 2027 porta per la prima volta due ospiti internazionali: il Rytmus Musikgymnasium di
          Göteborg, in Svezia, e la big band del Gymnasium Bethel di Bielefeld, in Germania.
        </p>
        <p>
          Non è un saggio, ma una restituzione pubblica: il momento in cui il lavoro fatto durante l'anno —
          nelle scuole di musica come nelle aule delle scuole della rete — si mostra alla città, in musica.
        </p>
      </div>

      {ANTEPRIMA.length > 0 && (
        <section class="gallery-section" aria-label="Foto delle edizioni passate">
          <div class="section-head">
            <h2>Le edizioni passate</h2>
          </div>
          <div class="gallery-preview">
            {ANTEPRIMA.map(foto => (
              <div class="gallery-preview-item">
                <img src={foto.src} alt={foto.alt} loading="lazy" />
              </div>
            ))}
          </div>
          <a class="gallery-link" href="/eventi/voglio-live-foto">Guarda tutte le foto delle edizioni passate →</a>
        </section>
      )}

      <section class="cta-section" aria-label="Contatti">
        <h2>Vuoi saperne di più su Voglio Live 2027?</h2>
        <p class="subtitle">Scrivici per restare aggiornato sul programma e sulle modalità di partecipazione.</p>
        <div class="hero-actions">
          <a class="btn btn-accent" href="https://form.jotform.com/262432547070049" target="_blank" rel="noopener">Richiedi info</a>
        </div>
      </section>

    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  :root {
    --green: #0f5f53;
    --accent: #f2a844;
    --ink: #0b0b0b;
    --surface: #f2f4f3;
    --radiusLg: 28px;
    --radius: 18px;
    --shadow: 0 12px 28px rgba(0,0,0,.08);
    --border: 1px solid rgba(11,11,11,.18);
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: "Lexend", system-ui, sans-serif; color: var(--ink); background: #fff; }
  a { color: inherit; }

  .container { width: min(1120px, calc(100% - 32px)); margin: 0 auto; padding: 14px 0 90px; }

  .hero-media {
    margin-top: 6px;
    width: 100%;
    min-height: 520px;
    border-radius: 28px;
    overflow: hidden;
    position: relative;
    background: #eef1ef;
    box-shadow: 0 12px 28px rgba(0,0,0,.08);
  }
  .hero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .hero-caption {
    margin: 8px 0 0;
    font-family: "Lexend", sans-serif;
    font-size: 12px;
    line-height: 1.5;
    color: #8a8a8a;
  }

  .page-content { margin: 24px 0 60px; }
  .kicker { font-family: "Inter", sans-serif; font-weight: 800; font-size: 13px; margin: 0 0 10px; }
  .kicker a { color: var(--green); text-decoration: none; }
  .kicker a:hover { text-decoration: underline; }
  .page-content h1 {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: clamp(32px, 4.4vw, 44px);
    margin: 0 0 14px;
  }
  .lead {
    font-family: "Lexend", sans-serif;
    font-size: 19px;
    line-height: 1.6;
    opacity: .82;
    margin: 0 0 32px;
  }

  .info-pratiche {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    background: var(--surface);
    border-radius: var(--radius);
    padding: 24px;
    margin: 0 0 40px;
  }
  @media (min-width: 640px) {
    .info-pratiche { grid-template-columns: repeat(3, 1fr); }
  }
  .info-item { display: flex; flex-direction: column; gap: 4px; }
  .info-label {
    font-family: "Inter", sans-serif;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: .3px;
    text-transform: uppercase;
    color: var(--green);
  }
  .info-value {
    font-family: "Lexend", sans-serif;
    font-size: 16px;
    font-weight: 600;
  }
  .info-value a { color: var(--green); text-decoration: underline; }

  .testo-intro { margin-bottom: 64px; }
  .testo-intro p {
    font-family: "Lexend", sans-serif;
    opacity: .82;
    line-height: 1.65;
    font-size: 17px;
    margin: 0 0 16px;
  }
  .testo-intro p:last-child { margin-bottom: 0; }

  h2 { margin: 0; font-family: "Inter", sans-serif; font-weight: 900; font-size: 26px; letter-spacing: -.25px; }

  .gallery-section { margin-bottom: 64px; }
  .gallery-section .section-head { margin-bottom: 20px; }
  .gallery-section h2 { font-size: 22px; }
  .gallery-preview {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  @media (min-width: 640px) {
    .gallery-preview { grid-template-columns: repeat(3, 1fr); }
  }
  .gallery-preview-item {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
    aspect-ratio: 4 / 3;
  }
  .gallery-preview-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .gallery-link {
    display: inline-block;
    margin-top: 18px;
    font-family: "Inter", sans-serif;
    font-weight: 800;
    font-size: 14px;
    color: var(--green);
    text-decoration: none;
  }
  .gallery-link:hover { text-decoration: underline; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    border-radius: 999px;
    font-family: "Inter", sans-serif;
    font-weight: 900;
    border: var(--border);
    box-shadow: var(--shadow);
    text-decoration: none;
  }
  .btn-accent { background: var(--accent); color: #1b1b1b; }

  .cta-section {
    text-align: center;
    background: var(--surface);
    border-radius: var(--radiusLg);
    padding: 56px 32px;
  }
  .cta-section .subtitle { margin: 12px auto 0; max-width: 60ch; opacity: .74; font-size: 16px; line-height: 1.5; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; margin-top: 26px; }
</style>
