---
import BaseLayout from '../layouts/layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Pagina non trovata" description="La pagina che cerchi non esiste o è stata spostata. Torna alla home di Jam Session APS.">
  <Header />
  <div class="container">
    <main class="page-content">
      <p class="kicker">Errore 404</p>
      <h1>Questa pagina non è nel nostro repertorio</h1>
      <p class="lead">Il link che hai seguito potrebbe essere vecchio o scritto in modo diverso. Prova a tornare alla home o dai un'occhiata ai nostri corsi.</p>
      <div class="hero-actions">
        <a class="btn btn-accent" href="/">Torna alla home</a>
        <a class="btn btn-outline" href="/corsi">Vedi i corsi</a>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  :root {
    --green: #0f5f53;
    --accent: #f2a844;
    --ink: #0b0b0b;
    --border: 1px solid rgba(11,11,11,.18);
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: "Lexend", system-ui, sans-serif; color: var(--ink); background: #fff; }
  a { color: inherit; }

  .container { width: min(720px, calc(100% - 32px)); margin: 0 auto; padding: 14px 0 90px; }
  .page-content { margin: 96px 0 120px; text-align: center; }
  .kicker { font-family: "Inter", sans-serif; font-weight: 800; font-size: 13px; color: var(--green); margin: 0 0 10px; }
  .page-content h1 {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: clamp(28px, 4.4vw, 40px);
    margin: 0 0 16px;
  }
  .lead {
    font-family: "Lexend", sans-serif;
    font-size: 18px;
    line-height: 1.6;
    opacity: .78;
    margin: 0 auto 32px;
    max-width: 48ch;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    border-radius: 999px;
    font-family: "Inter", sans-serif;
    font-weight: 900;
    border: var(--border);
    text-decoration: none;
  }
  .btn-accent { background: var(--accent); color: #1b1b1b; box-shadow: 0 12px 28px rgba(0,0,0,.08); }
  .btn-outline { background: #fff; color: var(--ink); }
</style>
