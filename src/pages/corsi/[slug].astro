---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const corsi = await getCollection('corsi');
  return corsi.map(corso => ({
    params: { slug: corso.id },
    props: { corso },
  }));
}

const { corso } = Astro.props;
const { title, intro, immagine, video, fasce_eta, livelli, metodo, team, nota_team } = corso.data;
---

<BaseLayout title={`${title} — Jam Session APS`} description={intro}>
  <Header />
  <div class="container">
    {video ? (
      <div class="hero-media">
        <video src={video} autoplay muted loop playsinline></video>
      </div>
    ) : immagine ? (
      <div class="hero-media">
        <img src={immagine} alt={`Lezione di ${title} a Jam Session`} />
      </div>
    ) : null}
    <main class="page-content">
      <h1>{title}</h1>
      <p class="intro">{intro}</p>

      {fasce_eta && fasce_eta.length > 0 && (
        <section class="block block-eta">
          <h2>Le fasce d'età</h2>
          <div class="eta-grid">
            {fasce_eta.map(f => (
              <div class="eta-card">
                <span class="eta-nome">{f.nome}</span>
                <span class="eta-range">{f.range}</span>
              </div>
            ))}
          </div>
        </section>
      )}

      {livelli && livelli.length > 0 && (
        <section class="block">
          <h2>I livelli</h2>
          <div class="livelli-grid">
            {livelli.map(l => (
              <div class="livello-card">
                <h3>{l.nome}</h3>
                <p>{l.descrizione}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <section class="block">
        <h2>Come funzionano le lezioni</h2>
        <p>{metodo}</p>
      </section>

      <section class="block">
        {team && team.length > 0 ? (
          <>
            <h2>Il team docenti</h2>
            <div class="team-list">
              {team.map(t => (
                <div class="team-item">
                  <div class="team-photo">
                    {t.foto && <img src={t.foto} alt={t.nome} />}
                  </div>
                  <div class="team-info">
                    <div class="team-name">{t.nome}</div>
                    <div class="team-role">{t.ruolo}</div>
                    {t.tratto && <p class="team-tratto">{t.tratto}</p>}
                  </div>
                </div>
              ))}
            </div>
          </>
        ) : nota_team ? (
          <>
            <h2>Il coach</h2>
            <p class="team-nota">{nota_team}</p>
          </>
        ) : (
          <>
            <h2>Il team docenti</h2>
            <p class="team-placeholder">Il team docenti di questo dipartimento sarà presto pubblicato.</p>
          </>
        )}
      </section>

      <div class="cta-block">
        <a class="btn btn-accent" href="https://form.jotform.com/262432547070049" target="_blank" rel="noopener">Richiedi info su questo corso</a>
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  .container {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
    padding: 14px 0 90px;
  }
  .page-content {
    margin: 46px 0 60px;
  }
  .hero-media {
    margin-top: 6px;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 28px;
    overflow: hidden;
    position: relative;
    background: #eef1ef;
    box-shadow: 0 12px 28px rgba(0,0,0,.08);
  }
  .hero-media img,
  .hero-media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .page-content h1 {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: clamp(36px, 4.4vw, 50px);
    margin: 0 0 20px;
  }
  .intro {
    font-family: "Lexend", sans-serif;
    opacity: .78;
    line-height: 1.65;
    font-size: 18px;
  }
  .block { margin-top: 64px; }
  .block h2 {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 28px;
    margin: 0 0 24px;
  }
  .block p {
    font-family: "Lexend", sans-serif;
    opacity: .78;
    line-height: 1.65;
    font-size: 17px;
  }

  /* Fasce d'età */
  .eta-grid { display: grid; gap: 18px; grid-template-columns: repeat(3, 1fr); }
  .eta-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    background: #f6ead6;
    border: 1px solid rgba(11,11,11,.1);
    border-radius: 18px;
    padding: 26px 16px;
  }
  .eta-nome {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 19px;
  }
  .eta-range {
    font-family: "Lexend", sans-serif;
    opacity: .7;
    font-size: 15px;
  }

  .livelli-grid { display: grid; gap: 22px; }
  .livello-card {
    background: #f2f4f3;
    border: 1px solid rgba(11,11,11,.1);
    border-radius: 18px;
    padding: 26px;
  }
  .livello-card h3 {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 18px;
    margin: 0 0 10px;
  }
  .livello-card p {
    font-family: "Lexend", sans-serif;
    opacity: .74;
    font-size: 15px;
    margin: 0;
    line-height: 1.55;
  }
  .team-list { display: grid; gap: 18px; }
  .team-item {
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 18px 22px;
    border-radius: 14px;
    background: #fff;
    border: 1px solid rgba(11,11,11,.1);
  }
  .team-photo {
    flex: 0 0 auto;
    width: 168px;
    height: 168px;
    border-radius: 16px;
    background: #f2f4f3;
    border: 1px solid rgba(11,11,11,.1);
    overflow: hidden;
  }
  .team-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .team-info { flex: 1 1 auto; min-width: 0; }
  .team-name {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 21px;
  }
  .team-role {
    font-family: "Lexend", sans-serif;
    opacity: .65;
    font-size: 17px;
    margin-top: 4px;
  }
  .team-tratto {
    margin: 8px 0 0;
    font-size: 14px;
    font-style: italic;
    opacity: .8;
  }
  .team-placeholder {
    font-family: "Lexend", sans-serif;
    opacity: .6;
    font-style: italic;
  }
  .team-nota {
    font-family: "Lexend", sans-serif;
    opacity: .78;
    line-height: 1.65;
    font-size: 17px;
  }
  .cta-block { margin-top: 56px; }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    border-radius: 999px;
    font-family: "Inter", sans-serif;
    font-weight: 900;
    border: 1px solid rgba(11,11,11,.18);
    box-shadow: 0 12px 28px rgba(0,0,0,.08);
  }
  .btn-accent { background: #f2a844; color: #1b1b1b; text-decoration: none; }

  @media (min-width: 768px) {
    .hero-media { aspect-ratio: auto; min-height: 520px; }
    .livelli-grid { grid-template-columns: repeat(3, 1fr); }
    .team-list { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 560px) {
    .eta-grid { grid-template-columns: 1fr; }
  }
</style>
