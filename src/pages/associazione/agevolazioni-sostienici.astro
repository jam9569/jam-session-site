---
import BaseLayout from '../../layouts/layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Agevolazioni Fiscali & Sostienici — Jam Session APS">
  <Header />
  <main class="page-placeholder">
    <h1>Agevolazioni Fiscali & Sostienici</h1>
    <p>Contenuto in arrivo.</p>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-placeholder {
    width: min(900px, calc(100% - 32px));
    margin: 60px auto;
    min-height: 40vh;
  }
  .page-placeholder h1 {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 40px;
    margin-bottom: 12px;
  }
  .page-placeholder p {
    font-family: "Lexend", sans-serif;
    opacity: .7;
  }
</style>