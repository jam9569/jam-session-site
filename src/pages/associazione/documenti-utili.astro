---
import BaseLayout from '../../layouts/layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Documenti Utili — Jam Session APS">
  <Header />
  <div class="container">
    <main class="page-content">
      <h1>Documenti Utili</h1>
      <p>Contenuto in arrivo.</p>
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  .container {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
    padding: 14px 0 90px;
  }
  .page-content {
    margin: 46px 0 60px;
    max-width: 900px;
  }
  .page-content h1 {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 40px;
    margin-bottom: 12px;
  }
  .page-content p {
    font-family: "Lexend", sans-serif;
    opacity: .7;
  }
</style>