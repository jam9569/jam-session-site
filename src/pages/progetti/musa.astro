---
import BaseLayout from '../../layouts/layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const FASI = [
  {
    titolo: "Sei laboratori",
    testo: "Libera professione, accesso al lavoro pubblico, performance dal vivo, leadership nella direzione di un ensemble, ruoli tecnici e progettazione culturale: incontri pratici, con casi reali, simulazioni contrattuali e strumenti concreti da portare a casa.",
  },
  {
    titolo: "Incubatore e mentoring",
    testo: "Le partecipanti sviluppano un proprio micro-progetto musicale, completo di piano operativo e strategia di sostenibilità, affiancate da mentor dedicati fino alla sua presentazione pubblica. Ai tre migliori progetti va un micro-fondo di 300 euro per realizzarli.",
  },
  {
    titolo: "Due eventi pubblici",
    testo: "Un concerto e una tavola rotonda con professioniste del settore aprono il percorso; un secondo evento, con la presentazione dei micro-progetti nati durante l'incubatore, lo chiude.",
  },
];

// Calendario del percorso (dal volantino MUSA). "fine" = ultimo giorno
// dell'appuntamento: serve per segnare in automatico quelli gia' svolti.
const CALENDARIO = [
  { quando: "18 giugno 2026", fine: "2026-06-18", titolo: "Evento pubblico di apertura e lancio della call" },
  { quando: "Luglio 2026", fine: "2026-07-31", titolo: "Raccolta delle candidature e selezione delle partecipanti" },
  { quando: "Sabato 26 settembre 2026", fine: "2026-09-26", orario: "15:00–18:00", titolo: "Laboratorio 1 — Leadership e direzione di ensemble", chi: "Alice Sacchi, cantante" },
  { quando: "Sabato 24 ottobre 2026", fine: "2026-10-24", orario: "15:00–18:00", titolo: "Laboratorio 2 — Libera professione musicale", chi: "Paola Giorgioni, commercialista", href: "/news/musa-secondo-laboratorio" },
  { quando: "Domenica 29 novembre 2026", fine: "2026-11-29", orario: "15:00–18:00", titolo: "Laboratorio 3 — Accesso al lavoro pubblico", chi: "Silvia Carrozzino, docente del Conservatorio G.B. Martini di Bologna", href: "/news/musa-terzo-laboratorio" },
  { quando: "Sabato 12 dicembre 2026", fine: "2026-12-12", orario: "15:00–18:00", titolo: "Laboratorio 4 — Progettazione culturale", chi: "Alexandra Storari, progettista", href: "/news/musa-quarto-laboratorio" },
  { quando: "Sabato 16 gennaio 2027", fine: "2027-01-16", orario: "15:00–18:00", titolo: "Laboratorio 5 — Musicista performer", chi: "Roberta Giallo, musicista performer" },
  { quando: "Sabato 20 febbraio 2027", fine: "2027-02-20", orario: "15:00–18:00", titolo: "Laboratorio 6 — Ruoli tecnici e gender gap", chi: "Chiara Amici, fonica" },
  { quando: "Marzo–aprile 2027", fine: "2027-04-30", titolo: "Incubatore con mentoring e sviluppo dei micro-progetti" },
  { quando: "Maggio 2027", fine: "2027-05-31", titolo: "Evento finale pubblico e presentazione dei 3 micro-progetti selezionati" },
];
const oggi = new Date().toISOString().slice(0, 10);
const calendario = CALENDARIO.map(e => ({ ...e, svolto: e.fine < oggi }));
---

<BaseLayout title="Musa — Jam Session APS" description="Musa: il percorso di Jam Session APS per l'autonomia professionale di giovani musiciste, tra laboratori, incubatore e mentoring dedicato.">
  <Header />
  <div class="container">
    <div class="hero-media">
      <img src="/assets/progetti/musa-logo-cover.webp" alt="Musa — Percorsi di autonomia professionale per giovani donne nella musica" width="2000" height="863" />
    </div>
    <main class="page-content">
      <p class="kicker">Parità di genere nella musica</p>
      <h1>Musa</h1>
      <p class="lead">Uno spazio per trasformare l'ispirazione in competenza professionale, e l'aspirazione in autonomia economica.</p>

      <div class="testo-intro">
        <p>
          Nel settore musicale la parità resta una strada in salita: le donne sono ancora una minoranza
          nei ruoli tecnici, produttivi e decisionali, e chi sceglie la musica come professione si scontra
          spesso con la difficoltà di negoziare un compenso, strutturare la propria attività autonoma, o
          immaginarsi alla guida di un ensemble. Musa nasce per intervenire proprio lì, dove la formazione
          musicale tradizionale si ferma: non insegna a suonare meglio, ma a costruire una carriera.
        </p>
        <p>
          Il percorso, rivolto a un gruppo di 15-20 giovani musiciste tra i 18 e i 30 anni di Bologna e
          della Città Metropolitana, si sviluppa da giugno 2026 a maggio 2027 e unisce sei laboratori
          tematici a un vero e proprio incubatore, dove sviluppare un proprio progetto musicale con il
          sostegno di mentor dedicati. Il tutto si apre e si chiude con due momenti pubblici, pensati per
          portare la riflessione sulla parità di genere nella musica fuori dall'aula e dentro la città.
        </p>
      </div>

      <section aria-label="Come funziona">
        <div class="section-head">
          <h2>Come funziona</h2>
        </div>
        <div class="fasi-grid">
          {FASI.map(f => (
            <div class="fase-card">
              <h3>{f.titolo}</h3>
              <p>{f.testo}</p>
            </div>
          ))}
        </div>
      </section>

      <section aria-label="Calendario">
        <div class="section-head">
          <h2>Calendario</h2>
          <p class="subtitle">I sei laboratori durano 3 ore ciascuno. Per informazioni e iscrizioni: <a href="tel:+393202244932">320 2244932</a> · <a href="mailto:segreteria@jamsessionaps.it">segreteria@jamsessionaps.it</a></p>
        </div>
        <ol class="calendario">
          {calendario.map(e => (
            <li class={e.svolto ? "tappa svolta" : "tappa"}>
              <p class="tappa-quando">
                {e.quando}{e.orario && <span> · {e.orario}</span>}
                {e.svolto && <span class="tappa-badge">Svolto</span>}
              </p>
              <p class="tappa-titolo">{e.href && !e.svolto ? <a href={e.href}>{e.titolo}</a> : e.titolo}</p>
              {e.chi && <p class="tappa-chi">con {e.chi}</p>}
            </li>
          ))}
        </ol>
        <p class="nota-fondo">Micro-fondo dell'incubatore: 3 progetti da 300 euro.</p>
        <div class="download-row">
          <a class="btn btn-outline-dark" href="/downloads/musa-opuscolo.pdf" target="_blank" rel="noopener">Scarica l'opuscolo MUSA (PDF)</a>
        </div>
      </section>

      <p class="partner-nota">
        Musa è sostenuto da Fondazione del Monte di Bologna e Ravenna nell'ambito del bando "Percorsi
        per la parità di genere".
      </p>

      <div class="loghi-partner" aria-label="Con il contributo di">
        <p class="dicitura-loghi">Con il contributo di</p>
        <div class="loghi-row">
          <img src="/assets/progetti/fondazione-del-monte-logo.png" alt="Fondazione del Monte di Bologna e Ravenna, 1473" width="600" height="183" />
        </div>
      </div>

      <section class="cta-section" aria-label="Contatti">
        <h2>Vuoi saperne di più su Musa?</h2>
        <p class="subtitle">Scrivici per conoscere il progetto, ospitare un laboratorio o sostenere una nuova edizione.</p>
        <div class="hero-actions">
          <a class="btn btn-accent" href="https://form.jotform.com/262432547070049" target="_blank" rel="noopener">Richiedi info</a>
        </div>
      </section>

    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  :root {
    --green: #0f5f53;
    --accent: #f2a844;
    --ink: #0b0b0b;
    --surface: #f2f4f3;
    --radius: 18px;
    --radiusLg: 28px;
    --shadow: 0 12px 28px rgba(0,0,0,.08);
    --border: 1px solid rgba(11,11,11,.18);
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: "Lexend", system-ui, sans-serif; color: var(--ink); background: #fff; }
  a { color: inherit; }

  .container { width: min(1120px, calc(100% - 32px)); margin: 0 auto; padding: 14px 0 90px; }
  .hero-media {
    margin-top: 6px;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: 28px;
    overflow: hidden;
    position: relative;
    background: #fff;
    box-shadow: 0 12px 28px rgba(0,0,0,.08);
  }
  .hero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    padding: 20px;
    box-sizing: border-box;
    display: block;
  }
  .page-content { margin: 46px 0 60px; }
  .kicker { font-family: "Inter", sans-serif; font-weight: 800; font-size: 13px; color: var(--green); margin: 0 0 10px; }
  .page-content h1 {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: clamp(32px, 4.4vw, 44px);
    margin: 0 0 14px;
  }
  .lead {
    font-family: "Lexend", sans-serif;
    font-size: 19px;
    line-height: 1.6;
    opacity: .82;
    margin: 0 0 32px;
  }

  .testo-intro { margin-bottom: 64px; }
  .testo-intro p {
    font-family: "Lexend", sans-serif;
    opacity: .82;
    line-height: 1.65;
    font-size: 17px;
    margin: 0 0 16px;
  }
  .testo-intro p:last-child { margin-bottom: 0; }

  main > section { margin-top: 72px; }
  .section-head { margin-bottom: 24px; }
  h2 { margin: 0; font-family: "Inter", sans-serif; font-weight: 900; font-size: 26px; letter-spacing: -.25px; }
  .subtitle { margin: 10px 0 0; opacity: .74; font-size: 16px; line-height: 1.5; }

  .fasi-grid {
    display: grid;
    gap: 18px;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .hero-media { aspect-ratio: auto; min-height: 520px; }
    .fasi-grid { grid-template-columns: repeat(3, 1fr); }
  }
  .fase-card {
    background: var(--surface);
    border: 1px solid rgba(11,11,11,.1);
    border-radius: var(--radius);
    padding: 24px;
  }
  .fase-card h3 {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 17px;
    margin: 0 0 10px;
    color: var(--green);
  }
  .fase-card p {
    font-family: "Lexend", sans-serif;
    font-size: 14px;
    line-height: 1.55;
    opacity: .78;
    margin: 0;
  }

  .partner-nota {
    margin: 40px 0 0;
    font-family: "Lexend", sans-serif;
    font-size: 14px;
    line-height: 1.6;
    opacity: .6;
    font-style: italic;
  }

  .loghi-partner { margin: 20px 0 0; }
  .dicitura-loghi {
    margin: 0 0 12px;
    font-family: "Lexend", sans-serif;
    font-size: 12px;
    opacity: .55;
    text-transform: uppercase;
    letter-spacing: .05em;
  }
  .loghi-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
  }
  .loghi-row img {
    height: 88px;
    width: auto;
    object-fit: contain;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    border-radius: 999px;
    font-family: "Inter", sans-serif;
    font-weight: 900;
    border: var(--border);
    box-shadow: var(--shadow);
    text-decoration: none;
  }
  .btn-accent { background: var(--accent); color: #1b1b1b; }
  .btn-outline-dark { background: #fff; color: var(--ink); }

  .subtitle a { color: var(--green); font-weight: 600; }
  .calendario { list-style: none; margin: 0; padding: 0 0 0 22px; border-left: 3px solid rgba(15,95,83,.25); }
  .tappa { position: relative; padding: 0 0 22px 6px; }
  .tappa:last-child { padding-bottom: 0; }
  .tappa::before {
    content: ""; position: absolute; left: -32px; top: 3px;
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--green); border: 3px solid #fff; box-shadow: 0 0 0 1px rgba(15,95,83,.35);
  }
  .tappa.svolta::before { background: #c9d3d0; }
  .tappa.svolta .tappa-titolo, .tappa.svolta .tappa-quando { opacity: .55; }
  .tappa-quando { margin: 0 0 4px; font-family: "Inter", sans-serif; font-weight: 800; font-size: 14px; color: var(--green); }
  .tappa-badge {
    display: inline-block; margin-left: 8px; padding: 1px 8px; border-radius: 999px;
    background: var(--surface); border: 1px solid rgba(11,11,11,.15);
    font-size: 11px; font-weight: 700; color: var(--ink); vertical-align: 1px;
  }
  .tappa-titolo { margin: 0; font-family: "Lexend", sans-serif; font-size: 17px; line-height: 1.45; }
  .tappa-titolo a { color: inherit; text-decoration-color: rgba(15,95,83,.45); text-underline-offset: 3px; }
  .tappa-chi { margin: 4px 0 0; font-family: "Lexend", sans-serif; font-size: 14px; opacity: .7; }
  .nota-fondo { margin: 26px 0 0; font-family: "Lexend", sans-serif; font-size: 15px; font-weight: 600; }
  .download-row { margin-top: 22px; }

  .cta-section {
    text-align: center;
    background: var(--surface);
    border-radius: var(--radiusLg);
    padding: 56px 32px;
  }
  .cta-section .subtitle { margin: 12px auto 0; max-width: 60ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; margin-top: 26px; }
</style>
