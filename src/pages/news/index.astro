---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

// L'associazione ragiona per anno sociale (es. "2026/2027", da settembre ad agosto),
// non per anno solare: il filtro sotto raggruppa le news di conseguenza.
function annoSociale(d: Date) {
  const y = d.getFullYear();
  return d.getMonth() >= 8 ? `${y}/${y + 1}` : `${y - 1}/${y}`;
}

const newsEntries = await getCollection('news');
const news = newsEntries
  .sort((a, b) => (a.data.date > b.data.date ? 1 : -1))
  .map(n => {
    const d = new Date(n.data.date);
    return {
      slug: n.id,
      title: n.data.title,
      dateDisplay: d.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' }),
      annoSociale: annoSociale(d),
    };
  });

const ANNI_SOCIALI = [...new Set(news.map(n => n.annoSociale))].sort((a, b) => b.localeCompare(a));
---

<BaseLayout title="News — Jam Session APS" description="L'archivio di tutte le news di Jam Session APS: aggiornamenti su corsi, iscrizioni, saggi ed eventi.">
  <Header />
  <div class="container">
    <main class="page-content">
      <h1>News</h1>
      <p class="lead">Tutti gli aggiornamenti di Jam Session APS, dalla data più vicina alla più lontana.</p>

      {news.length > 0 && ANNI_SOCIALI.length > 1 && (
        <div class="news-filters" role="group" aria-label="Filtra le news per anno sociale">
          <button type="button" class="filter-btn is-active" data-year="all">Tutte</button>
          {ANNI_SOCIALI.map(y => (
            <button type="button" class="filter-btn" data-year={y}>{y}</button>
          ))}
        </div>
      )}

      {news.length > 0 ? (
        <div class="news-grid" id="news-grid">
          {news.map(n => (
            <a class="news-card" href={`/news/${n.slug}`} data-year={n.annoSociale}>
              <span class="news-date">{n.dateDisplay}</span>
              <span class="news-title">{n.title}</span>
              <span class="news-more">Leggi i dettagli →</span>
            </a>
          ))}
        </div>
      ) : (
        <div class="empty-state">
          <p>Non ci sono ancora news pubblicate.</p>
        </div>
      )}

    </main>
    <Footer />
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLAnchorElement>('#news-grid .news-card');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      const year = btn.dataset.year;
      buttons.forEach(b => b.classList.toggle('is-active', b === btn));
      cards.forEach(card => {
        const show = year === 'all' || card.dataset.year === year;
        card.hidden = !show;
      });
    });
  });
</script>

<style>
  :root {
    --green: #0f5f53;
    --ink: #0b0b0b;
    --surface: #f2f4f3;
    --radius: 18px;
    --radiusLg: 28px;
    --shadow: 0 12px 28px rgba(0,0,0,.08);
    --border: 1px solid rgba(11,11,11,.18);
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: "Lexend", system-ui, sans-serif; color: var(--ink); background: #fff; }
  a { color: inherit; }

  .container { width: min(1120px, calc(100% - 32px)); margin: 0 auto; padding: 14px 0 90px; }
  .page-content { margin: 16px 0 60px; }
  .page-content h1 {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: clamp(32px, 4.4vw, 44px);
    margin: 0 0 14px;
  }
  .lead {
    font-family: "Lexend", sans-serif;
    font-size: 19px;
    line-height: 1.6;
    opacity: .82;
    margin: 0 0 28px;
  }

  .news-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 28px;
  }
  .filter-btn {
    font-family: "Inter", sans-serif;
    font-weight: 800;
    font-size: 13px;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid rgba(11,11,11,.18);
    background: #fff;
    color: var(--ink);
    cursor: pointer;
  }
  .filter-btn.is-active {
    background: var(--green);
    border-color: var(--green);
    color: #fff;
  }

  .news-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 640px) { .news-grid { grid-template-columns: repeat(2, 1fr); } }
  .news-card {
    display: block;
    background: #fff;
    border-radius: var(--radius);
    border: 1px solid rgba(11,11,11,.1);
    box-shadow: var(--shadow);
    padding: 22px;
    text-decoration: none;
    color: inherit;
  }
  .news-card[hidden] { display: none; }
  .news-date { display: block; font-size: 12px; opacity: .62; font-weight: 700; font-family: "Inter", sans-serif; }
  .news-title { display: block; margin: 10px 0 0; font-family: "Inter", sans-serif; font-weight: 900; font-size: 16px; line-height: 1.25; }
  .news-more { display: block; margin-top: 10px; font-size: 13px; opacity: .75; font-weight: 800; font-family: "Inter", sans-serif; color: var(--green); }

  .empty-state {
    background: var(--surface);
    border-radius: var(--radiusLg);
    padding: 56px 32px;
    text-align: center;
  }
  .empty-state p {
    font-family: "Lexend", sans-serif;
    opacity: .74;
    font-size: 17px;
    margin: 0;
  }
</style>
