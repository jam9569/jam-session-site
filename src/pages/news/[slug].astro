---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, date, fino, pulsante, immagine } = entry.data;
const lunga = (s: string, conAnno = true) =>
  new Date(s).toLocaleDateString('it-IT', conAnno ? { day: 'numeric', month: 'long', year: 'numeric' } : { day: 'numeric', month: 'long' });
const dateDisplay = fino
  ? `dal ${lunga(date, date.slice(0, 4) !== fino.slice(0, 4))} al ${lunga(fino)}`
  : lunga(date);
const { Content } = await render(entry);
---

<BaseLayout title={`${title} — Jam Session APS`} description={title}>
  <Header />
  <div class="container">
    <main class="page-content" class:list={{ "has-image": !!immagine }}>
      <p class="kicker"><a href="/news">← Tutte le news</a></p>
      <div class="news-layout">
        <div class="news-text">
          <span class="news-date">{dateDisplay}</span>
          <h1>{title}</h1>
          <div class="news-body">
            <Content />
          </div>
          {pulsante && (
            <p class="news-cta">
              <a class="btn btn-accent" href={pulsante.link}>{pulsante.testo}</a>
            </p>
          )}
        </div>
        {immagine && (
          <div class="news-image">
            <img src={immagine} alt={title.replace(/\n/g, " ")} loading="lazy" />
          </div>
        )}
      </div>
    </main>
    <Footer />
  </div>
</BaseLayout>

<style>
  :root {
    --green: #0f5f53;
    --ink: #0b0b0b;
    --border: 1px solid rgba(11,11,11,.18);
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: "Lexend", system-ui, sans-serif; color: var(--ink); background: #fff; }
  a { color: inherit; }

  .container { width: min(1120px, calc(100% - 32px)); margin: 0 auto; padding: 14px 0 90px; }
  .page-content { margin: 16px 0 60px; max-width: 900px; }
  .page-content.has-image { max-width: 1060px; }
  .kicker { font-family: "Inter", sans-serif; font-weight: 800; font-size: 13px; margin: 0 0 18px; }
  .kicker a { color: var(--green); text-decoration: none; }
  .kicker a:hover { text-decoration: underline; }
  .news-layout { display: grid; gap: 34px; }
  .news-date {
    display: block;
    font-family: "Inter", sans-serif;
    font-weight: 700;
    font-size: 13px;
    opacity: .6;
    margin-bottom: 10px;
  }
  .page-content h1 {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: clamp(28px, 4vw, 38px);
    margin: 0 0 30px;
    white-space: pre-line;
  }
  .news-image {
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid rgba(11,11,11,.18);
    box-shadow: 0 12px 28px rgba(0,0,0,.08);
  }
  .news-image img { width: 100%; height: auto; display: block; }
  .news-body {
    font-family: "Lexend", sans-serif;
    font-size: 17px;
    line-height: 1.7;
    opacity: .85;
  }
  .news-body p { margin: 0 0 18px; }
  .news-body p:last-child { margin-bottom: 0; }
  .news-cta { margin: 30px 0 0; }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    border-radius: 999px;
    font-family: "Inter", sans-serif;
    font-weight: 900;
    border: var(--border);
    box-shadow: 0 12px 28px rgba(0,0,0,.08);
    text-decoration: none;
  }
  .btn-accent { background: #f2a844; color: #1b1b1b; }

  @media (min-width: 860px) {
    .page-content.has-image .news-layout {
      grid-template-columns: 1.15fr 1fr;
      align-items: start;
    }
    .page-content.has-image .news-image { position: sticky; top: 24px; }
  }
</style>
