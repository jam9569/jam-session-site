---

<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{SITE.name} • {SITE.tagline}</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@700;800;900&family=Lexend:wght@300;400;500;600&display=swap" rel="stylesheet" />

  <style>
    :root{
      --green:#0f5f53;
      --greenDark:#0b4b42;
      --heroGreen:#0e4f46;
      --accent:#f2a844;
      --ink:#0b0b0b;
      --paper:#ffffff;
      --surface:#f2f4f3;

      --radius:18px;
      --radiusLg:28px;
      --shadow: 0 12px 28px rgba(0,0,0,.08);
      --border: 1px solid rgba(11,11,11,.18);
      --borderW: 1px solid rgba(255,255,255,.18);
    }

    *{ box-sizing:border-box }
    body{
      margin:0;
      font-family:"Lexend",system-ui,sans-serif;
      color:var(--ink);
      background:
        linear-gradient(0deg,rgba(255,255,255,.965),rgba(255,255,255,.965)),
        url("/assets/texture/paper-grain.jpg");
      background-size:cover;
      background-attachment: fixed;
    }

    a{ color:inherit; text-decoration:none; }
    img{ display:block; max-width:100%; }

    .container{
      width:min(1120px, calc(100% - 32px));
      margin:0 auto;
      padding:14px 0 90px;
    }

    /* HEADER */
    header{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:16px;
      margin:0;
      padding:0;
    }
    .brand{ display:flex; align-items:center; gap:12px; }
    .logo{
      width:44px; height:44px; border-radius:999px;
      background:var(--green);
      border: var(--border);
      overflow:hidden;
      flex:0 0 auto;
    }
    .brand-name{
      font-family:"Inter";
      font-weight:900;
      font-size:18px;
      line-height:1.1;
    }
    .brand-name small{
      display:block;
      font-size:12px;
      font-weight:600;
      opacity:.72;
      margin-top:3px;
    }
    nav{ display:none; gap:20px; font-family:"Inter"; font-weight:900; opacity:.9; }
    nav a:hover{ text-decoration:underline; text-underline-offset:4px; }

    .top-cta{
      padding:10px 16px;
      border-radius:999px;
      background:var(--accent);
      border: var(--border);
      box-shadow: var(--shadow);
      font-family:"Inter";
      font-weight:900;
      white-space:nowrap;
    }

    /* BUTTONS */
    .btn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:10px;
      padding:12px 18px;
      border-radius:999px;
      font-family:"Inter";
      font-weight:900;
      border: var(--border);
      box-shadow: var(--shadow);
      cursor:pointer;
      user-select:none;
    }
    .btn-green{ background:var(--green); color:#fff; }
    .btn-green:hover{ background:var(--greenDark); }
    .btn-accent{ background:var(--accent); color:#1b1b1b; }
    .btn-outline{
      background:rgba(255,255,255,.10);
      color:#fff;
      border: 2px solid rgba(255,255,255,.38);
      box-shadow:none;
    }

    /* HERO */
    .hero{
      margin-top:6px;
      border-radius:var(--radiusLg);
      background:var(--heroGreen);
      border: var(--border);
      box-shadow: var(--shadow);
      overflow:hidden;
      position:relative;
      min-height: 520px;
      display:grid;
      place-items:center;
      text-align:center;
    }
    .hero video{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      object-fit:cover;
    }
    .hero::after{
      content:"";
      position:absolute;
      inset:0;
      background: rgba(15,95,83,.72);
    }
    .hero-inner{
      position:relative;
      z-index:1;
      color:#fff;
      width:min(980px, calc(100% - 36px));
      padding: 42px 0;
    }
    .kicker{
      margin:0 0 18px;
      font-family:"Inter";
      font-weight:800;
      font-size:13px;
      opacity:.92;
    }
    .hero-title{
      margin:0 0 18px;
      font-family:"Inter";
      font-weight:900;
      line-height:1.03;
      letter-spacing:-.6px;
    }
    .hero-title span{ display:block; }
    .hero-title .line1{ font-size: clamp(36px, 7.2vw, 66px); }
    .hero-title .line2{
      font-size: clamp(22px, 4.6vw, 44px);
      white-space:nowrap;
    }
    @media (max-width: 390px){
      .hero-title .line2{ font-size: clamp(20px, 5.3vw, 34px); }
    }
    .hero-lead{
      margin:0 0 24px;
      opacity:.92;
      font-size:14px;
      line-height:1.5;
    }
    .hero-actions{
      display:flex;
      gap:12px;
      flex-wrap:wrap;
      justify-content:center;
    }

    /* SEZIONI */
    main > section:not(.hero){ margin-top: 96px; }

    .section-head{ margin-bottom: 26px; }
    h2{
      margin:0;
      font-family:"Inter";
      font-weight:900;
      font-size:26px;
      letter-spacing:-.25px;
    }
    .subtitle{
      margin:10px 0 0;
      opacity:.74;
      font-size:14px;
      max-width:72ch;
    }

    .grid{ display:grid; gap:22px; }
    .card{
      background:var(--surface);
      border-radius:var(--radius);
      border: var(--border);
      box-shadow: var(--shadow);
      padding:22px;
    }

    /* CORSI */
    .course{
      display:flex;
      align-items:center;
      justify-content:space-between;
      font-family:"Inter";
      font-weight:900;
    }
    .badge{
      background:var(--accent);
      border: var(--border);
      border-radius:999px;
      padding:6px 10px;
      font-size:12px;
      font-weight:900;
    }

    /* MICRO-FOTO (MOBILE NATURALE / DESKTOP TAGLIO CONTROLLATO) */
    .micro-photo{
      margin: 44px 0;
      border-radius:var(--radius);
      overflow:hidden;
      border: var(--border);
      box-shadow: var(--shadow);
    }
    .micro-photo img{
      width:100%;
      height:auto;
      display:block;
    }
    @media (min-width: 768px){
      .micro-photo{ height: 340px; }
      .micro-photo img{
        width:100%;
        height:100%;
        object-fit:cover;
        object-position:center;
      }
    }

    /* DOCENTI */
    .docenti-grid{ display:grid; gap:22px; }
    .docente{
      position:relative;
      border-radius:var(--radius);
      overflow:hidden;
      border: var(--border);
      box-shadow: var(--shadow);
      background:var(--surface);
    }
    .docente img{
      width:100%;
      aspect-ratio: 3/4;
      object-fit:cover;
      filter: grayscale(100%);
      opacity:.95;
    }
    .docente-info{
      position:absolute;
      left:12px; right:12px; bottom:12px;
    }
    .pill{
      display:inline-block;
      background:var(--accent);
      border: var(--border);
      border-radius:999px;
      padding:6px 10px;
      font-family:"Inter";
      font-weight:900;
      font-size:12px;
      margin-bottom:8px;
    }
    .namebar{
      background: rgba(15,95,83,.92);
      color:#fff;
      border: 1px solid rgba(255,255,255,.18);
      border-radius:14px;
      padding:10px 12px;
      font-family:"Inter";
      font-weight:900;
    }

    /* RECENSIONI */
    .review-photo{
      margin: 22px 0 34px;
      border-radius:var(--radius);
      overflow:hidden;
      border: var(--border);
      box-shadow: var(--shadow);
      height: 240px;
    }
    .review-photo img{
      width:100%;
      height:100%;
      object-fit:cover;
    }
    .reviews{ display:grid; gap:26px; }
    .review{ background:#fff; }
    .review p{
      margin:0 0 14px;
      opacity:.85;
      line-height:1.55;
      font-size:14px;
      font-weight:500;
    }
    .review-footer{
      display:flex;
      justify-content:space-between;
      gap:14px;
      align-items:baseline;
      font-family:"Inter";
      font-weight:900;
    }
    .review-footer small{
      font-family:"Lexend";
      font-weight:500;
      opacity:.62;
    }

    /* NEWS */
    .news-section{
      background:var(--green);
      border-radius:var(--radiusLg);
      padding: 38px;
      border: var(--borderW);
      box-shadow: var(--shadow);
      color:#fff;
    }
    .news-section h2{ color:#fff; }
    .news-section .subtitle{
      color: rgba(255,255,255,.82);
      opacity:1;
    }
    .news{ display:grid; gap:26px; }
    .news-card{
      background:#fff;
      color:var(--ink);
      border-radius:var(--radius);
      border: var(--border);
      box-shadow: var(--shadow);
      padding:22px;
    }
    .news-date{
      font-size:12px;
      opacity:.62;
      font-weight:700;
    }
    .news-title{
      margin:10px 0 0;
      font-family:"Inter";
      font-weight:900;
      font-size:16px;
      line-height:1.25;
    }
    .news-more{
      margin-top:10px;
      font-size:13px;
      opacity:.75;
      font-weight:800;
      font-family:Inter;
    }

    /* PARTNER: logo + nome a fianco */
    .partners{
      display:grid;
      grid-template-columns: 1fr;
      gap:14px;
    }
    .partner{
      background:#fff;
      border: var(--border);
      border-radius: 16px;
      padding:16px 16px;
      box-shadow: var(--shadow);
      display:flex;
      align-items:center;
      gap:14px;
      min-height:72px;
    }
    .partner-logo{
      width:86px;
      height:38px;
      flex:0 0 auto;
      display:flex;
      align-items:center;
      justify-content:center;
    }
    .partner-logo img{
      max-width:100%;
      max-height:100%;
      width:auto;
      height:auto;
      object-fit:contain;
    }
    .partner-name{
      font-family:"Inter";
      font-weight:900;
      font-size:14px;
      line-height:1.2;
      opacity:.9;
    }

    /* FOOTER */
    footer{
      margin-top: 130px;
      background:var(--green);
      border-radius:var(--radiusLg);
      padding: 42px;
      border: var(--borderW);
      box-shadow: var(--shadow);
      color:#fff;
    }
    .footer-top{
      display:grid;
      gap:22px;
    }
    .fcard{
      background:#fff;
      color:var(--ink);
      border: var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding:22px;
    }
    .f-title{
      font-family:"Inter";
      font-weight:900;
      font-size:16px;
      margin:0 0 10px;
    }
    .f-text{
      margin:0 0 10px;
      opacity:.85;
      font-size:14px;
      line-height:1.45;
    }
    .f-meta{
      font-size:13px;
      line-height:1.6;
      opacity:.9;
    }
    .f-meta a{
      color:inherit;
      text-decoration:underline;
      text-underline-offset:3px;
    }

    /* SOCIAL ICONS (coerenti, verdi, eleganti) */
    .socials{
      display:flex;
      gap:10px;
      margin-top:12px;
      flex-wrap:wrap;
    }
    .social{
      width:40px;
      height:40px;
      border-radius:999px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      background:#f6f7f7;
      border: 1px solid rgba(11,11,11,.12);
      color: var(--greenDark);
      transition: transform .12s ease, background .12s ease;
    }
    .social:hover{
      transform: translateY(-1px);
      background:#ffffff;
    }
    .social svg{
      width:18px;
      height:18px;
      display:block;
      fill: currentColor;
    }

    .form{ display:grid; gap:10px; margin-top:12px; }
    .form input{
      padding:12px 14px;
      border-radius:14px;
      border: 1px solid rgba(11,11,11,.18);
      font-family:"Lexend";
      font-size:14px;
    }
    .form button{
      padding:12px 16px;
      border-radius:999px;
      border:none;
      background: var(--accent);
      color:#1b1b1b;
      font-family:"Inter";
      font-weight:900;
      cursor:pointer;
    }
    .newsletter-note{
      margin-top:10px;
      font-size:12px;
      opacity:.72;
      line-height:1.35;
    }

    .footer-cta{
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      margin-top:22px;
    }
    .fbtn{
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:12px 16px;
      border-radius:999px;
      font-family:"Inter";
      font-weight:900;
      background:#fff;
      color: var(--greenDark);
      border: 1px solid rgba(255,255,255,.30);
    }
    .fbtn-ghost{
      background: rgba(255,255,255,.10);
      color:#fff;
      border: 1px solid rgba(255,255,255,.30);
    }

    /* footer links + european right */
    .footer-bottom{
      display:flex;
      align-items:flex-start;
      justify-content:space-between;
      gap:18px;
      margin-top:18px;
      flex-wrap:wrap;
    }
    .footer-links{
      display:flex;
      flex-wrap:wrap;
      gap:14px;
      font-family:"Inter";
      font-weight:900;
      font-size:13px;
      color: rgba(255,255,255,.96);
    }
    .footer-links a:hover{ text-decoration:underline; text-underline-offset:4px; }

    .footer-eu{
      margin-left:auto;
      font-family:"Inter";
      font-weight:900;
      font-size:13px;
      color: rgba(255,255,255,.96);
      white-space:nowrap;
    }
    .footer-eu a:hover{ text-decoration:underline; text-underline-offset:4px; }

    .copyright{
      margin-top:14px;
      font-size:12px;
      opacity:.9;
    }

    /* RESPONSIVE */
    @media (min-width: 768px){
      nav{ display:flex; }
      .grid{ grid-template-columns:1fr 1fr; }
      .docenti-grid{ grid-template-columns:repeat(4,1fr); }
      .reviews{ grid-template-columns:repeat(2,1fr); }
      .news{ grid-template-columns:repeat(2,1fr); }
      .partners{ grid-template-columns:repeat(2,1fr); }
      .footer-top{ grid-template-columns:1fr 1fr 1.2fr; }
    }
    @media (min-width: 980px){
      .partners{ grid-template-columns:repeat(3,1fr); }
    }
  </style>
</head>

<body>
  <div class="container">

    <header>
      <div class="brand">
        <div class="logo">
          <img src="/assets/logo-js.svg" alt="Jam Session" />
        </div>
        <div class="brand-name">
          {SITE.name}
          <small>{SITE.tagline}</small>
        </div>
      </div>

      <nav aria-label="Menu principale">
        {MENU.map(item => <a href={item.href}>{item.label}</a>)}
      </nav>

      <a class="top-cta" href="/contatti">Richiedi info</a>
    </header>

    <main>
      <section class="hero" aria-label="Hero">
        <!-- Quando hai il video (8–9s loop), scommenta -->
        <!-- <video src="/assets/hero/hero-8s.mp4" autoplay muted loop playsinline></video> -->

        <div class="hero-inner">
          <p class="kicker">Sede d’esame Trinity College London</p>

          <h1 class="hero-title">
            <span class="line1">Scopri la tua musica.</span>
            <span class="line2">In un luogo vivo, serio e aperto.</span>
          </h1>

          <p class="hero-lead">Una scuola-laboratorio musicale inclusiva davvero, affidabile nei fatti e innovativa per natura.</p>

          <div class="hero-actions">
            <a class="btn btn-accent" href="/contatti#prenota-prova">Prenota una prova <span aria-hidden="true">↗</span></a>
            <a class="btn btn-outline" href="/corsi">Vedi tutti i corsi</a>
          </div>
        </div>
      </section>

      <section aria-label="Corsi principali">
        <div class="section-head">
          <h2>I percorsi principali</h2>
          <p class="subtitle">Inizia da qui: scegli uno strumento e prenota una prova.</p>
        </div>

        <div class="grid">
          {CORSI_HOME.map(c => (
            <a class="card course" href={c.href}>
              <span>{c.title}</span>
              <span class="badge">Corso</span>
            </a>
          ))}
        </div>

        <div style="margin-top:22px;">
          <a class="btn btn-green" href="/corsi">Vedi tutti i corsi</a>
        </div>
      </section>

      <!-- FOTO 1 -->
      <div class="micro-photo" aria-label="Dettaglio lezione di pianoforte">
        <img
          src="/assets/home/lezione-pianoforte-jam-session.avif"
          alt="Lezione di pianoforte alla Jam Session APS"
          loading="lazy"
          decoding="async"
        />
      </div>

      <section aria-label="Docenti principali">
        <div class="section-head">
          <h2>I docenti dei corsi principali</h2>
          <p class="subtitle">Quattro volti, quattro percorsi. Poi scegliamo insieme quello giusto per te.</p>
        </div>

        <div class="docenti-grid">
          {DOCENTI.map(d => (
            <a class="docente" href={d.href} aria-label={`Apri profilo docente ${d.nome}`}>
              <img src={d.img} alt={`${d.nome} — ${d.corso}`} loading="lazy" decoding="async" />
              <div class="docente-info">
                <div class="pill">{d.corso}</div>
                <div class="namebar">{d.nome}</div>
              </div>
            </a>
          ))}
        </div>

        <div style="margin-top:22px;">
          <a class="btn btn-green" href="/docenti">Vedi tutti i docenti</a>
        </div>
      </section>

      <!-- FOTO 2 -->
      <div class="micro-photo" aria-label="Strumenti musicali in sede">
        <img
          src="/assets/home/chitarre-scuola-musica-jam-session.avif"
          alt="Chitarre e strumenti disponibili alla Jam Session APS"
          loading="lazy"
          decoding="async"
        />
      </div>

      <section aria-label="Recensioni">
        <div class="section-head">
          <h2>Recensioni</h2>
          <p class="subtitle">Quello che conta davvero: come ci si sente quando si suona insieme.</p>
        </div>

        <div class="review-photo" aria-label="Lezione di musica d’insieme">
          <img
            src="/assets/home/lezione-musica-insieme-jam-session.avif"
            alt="Lezione di musica d’insieme alla Jam Session APS"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="reviews">
          {RECENSIONI.map(r => (
            <div class="card review">
              <p>“{r.text}”</p>
              <div class="review-footer">
                <span>{r.author}</span>
                <small>{r.meta}</small>
              </div>
            </div>
          ))}
        </div>
      </section>

      <section class="news-section" aria-label="News">
        <div class="section-head" style="margin-bottom:22px;">
          <h2>News e novità</h2>
          <p class="subtitle">Eventi, saggi, laboratori: il sito resta vivo, come la scuola.</p>
        </div>

        <div class="news">
          {NEWS_HOME.map(n => (
            <a class="news-card" href={n.href} aria-label={`Apri news: ${n.title}`}>
              <div class="news-date">{n.date}</div>
              <div class="news-title">{n.title}</div>
              <div class="news-more">Leggi i dettagli →</div>
            </a>
          ))}
        </div>

        <div style="margin-top:22px;">
          <a class="btn btn-accent" href="/news">Tutte le news</a>
        </div>
      </section>

      <section aria-label="Partner">
        <div class="section-head">
          <h2>Camminano con noi</h2>
          <p class="subtitle">Partner tecnici, enti e associazioni con cui collaboriamo.</p>
        </div>

        <div class="partners">
          {PARTNER.map(p => (
            <a class="partner" href={p.href} aria-label={`Partner: ${p.name}`} title={p.name}>
              <div class="partner-logo">
                <img src={p.logo} alt={p.name} loading="lazy" decoding="async" />
              </div>
              <div class="partner-name">{p.name}</div>
            </a>
          ))}
        </div>
      </section>

    </main>

    <footer aria-label="Footer">
      <div class="footer-top">

        <div class="fcard">
          <div class="f-title">{SITE.name}</div>
          <p class="f-text">{SITE.addressLine1}<br/>{SITE.addressLine2}</p>
          <div class="f-meta"><strong>CF:</strong> {SITE.cf} &nbsp;·&nbsp; <strong>P.IVA:</strong> {SITE.piva}</div>
          <div class="f-meta">
            <strong>Email:</strong> <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br/>
            <strong>PEC:</strong> <a href={`mailto:${SITE.pec}`}>{SITE.pec}</a>
          </div>
        </div>

        <div class="fcard">
          <div class="f-title">Contatti & social</div>
          <p class="f-text">Seguici: eventi, saggi, novità e vita della scuola.</p>

          <div class="socials" aria-label="Social">
            {SOCIAL.map(s => (
              <a class="social" href={s.href} aria-label={s.label} title={s.label}>
                {s.key === "linkedin" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M4.98 3.5C4.98 4.88 3.87 6 2.49 6S0 4.88 0 3.5 1.11 1 2.49 1 4.98 2.12 4.98 3.5zM0 8h5v16H0zM8 8h4.8v2.2h.07c.67-1.27 2.3-2.6 4.73-2.6C22.4 7.6 24 10.4 24 14.2V24h-5v-8.6c0-2.05-.04-4.7-2.87-4.7-2.87 0-3.31 2.24-3.31 4.55V24H8z"/>
                  </svg>
                )}
                {s.key === "facebook" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M22 12a10 10 0 1 0-11.6 9.9v-7h-2.4V12h2.4V9.8c0-2.4 1.4-3.8 3.6-3.8 1 0 2 .2 2 .2v2.2h-1.1c-1.1 0-1.5.7-1.5 1.4V12h2.6l-.4 2.9h-2.2v7A10 10 0 0 0 22 12z"/>
                  </svg>
                )}
                {s.key === "instagram" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm10 2H7a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3zm-5 3.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 0 1 12 7.5zm0 2A2.5 2.5 0 1 0 14.5 12 2.5 2.5 0 0 0 12 9.5zM17.8 6.2a1 1 0 1 1-1 1 1 1 0 0 1 1-1z"/>
                  </svg>
                )}
                {s.key === "youtube" && (
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M23.5 6.2a3.1 3.1 0 0 0-2.2-2.2C19.4 3.5 12 3.5 12 3.5s-7.4 0-9.3.5A3.1 3.1 0 0 0 .5 6.2 32.6 32.6 0 0 0 0 12a32.6 32.6 0 0 0 .5 5.8 3.1 3.1 0 0 0 2.2 2.2c1.9.5 9.3.5 9.3.5s7.4 0 9.3-.5a3.1 3.1 0 0 0 2.2-2.2A32.6 32.6 0 0 0 24 12a32.6 32.6 0 0 0-.5-5.8zM9.7 15.5V8.5L15.9 12z"/>
                  </svg>
                )}
              </a>
            ))}
          </div>
        </div>

        <div class="fcard">
          <div class="f-title">Newsletter della scuola</div>
          <p class="f-text">Una mail ogni tanto: eventi, saggi, novità e idee per il tuo percorso musicale.</p>
          <form class="form" action="#" method="post" aria-label="Newsletter">
            <input type="email" name="email" placeholder="La tua email" autocomplete="email" required />
            <button type="submit">Iscrivimi</button>
          </form>
          <div class="newsletter-note">Niente spam. Disiscrizione in 1 click. Leggi la <a href="/privacy" style="color:inherit;text-decoration:underline;text-underline-offset:3px;">Privacy</a>.</div>
        </div>

      </div>

      <div class="footer-cta" aria-label="Azioni rapide">
        <a class="fbtn" href="/contatti">Richiedi info</a>
        <a class="fbtn fbtn-ghost" href="/contatti#whatsapp">Preferisci WhatsApp?</a>
      </div>

      <div class="footer-bottom" aria-label="Link e sezione europea">
        <div class="footer-links" aria-label="Link">
          <a href="/corsi">Corsi</a>
          <a href="/docenti">Docenti</a>
          <a href="/progetti">Progetti</a>
          <a href="/eventi">Eventi</a>
          <a href="/contatti">Contatti</a>
          <a href="/privacy">Privacy</a>
          <a href="/cookie">Cookie</a>
        </div>

        <div class="footer-eu">
          <a href="/european-partners" aria-label="For European Partners">🇬🇧 For European Partners</a>
        </div>
      </div>

      <div class="copyright">© {YEAR} Jam Session APS — a cura di Marco Badini</div>
    </footer>

  </div>
</body>
</html>