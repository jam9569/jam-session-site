---
interface Props {
  title?: string;
  description?: string;
  lang?: string;
  image?: string;
}
 
const {
  title = "Jam Session APS",
  description = "Scuola di canto e musica a Bologna. Corsi di canto, pianoforte, chitarra, DJ e molto altro. Sede d'esame Trinity College London.",
  lang = "it",
  image = "/assets/social/og-image.jpg",
} = Astro.props;
 
const SITE_NAME = "Jam Session APS";
const pageTitle = title.includes(SITE_NAME) ? title : `${title} • ${SITE_NAME}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---
 
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />

  <!-- Iubenda Cookie Solution: banner di consenso, deve caricare il prima possibile -->
  <script type="text/javascript" set:html={`
    var _iub = _iub || [];
    _iub.csConfiguration = {"siteId":1599914,"cookiePolicyId":74857805,"lang":"it"};
  `} />
  <script type="text/javascript" src="https://cs.iubenda.com/autoblocking/1599914.js"></script>
  <script type="text/javascript" src="//cdn.iubenda.com/cs/iubenda_cs.js" charset="UTF-8" async></script>

  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{pageTitle}</title>
  <link rel="canonical" href={canonicalURL} />
 
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content={lang === "it" ? "it_IT" : "en_GB"} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={imageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />
 
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@700;800;900&family=Lexend:wght@300;400;500;600&display=optional" rel="stylesheet" />
 
  <link rel="icon" href="/favicon.ico" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
 
  <style is:global>
    body {
      margin: 0;
      font-family: "Lexend", system-ui, sans-serif;
      color: #0b0b0b;
      background: #fff;
    }
    /* Evita che l'ultima riga di un paragrafo lasci una singola parola isolata ("vedova") */
    p, li, blockquote {
      text-wrap: pretty;
    }
  </style>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-TLPSFHLYV2"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-TLPSFHLYV2');
  </script>
</head>
<body>
  <slot />
</body>
</html>
