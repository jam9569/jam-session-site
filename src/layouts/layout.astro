---
interface Props {
  title?: string;
  description?: string;
  lang?: string;
  image?: string;
  preloadImage?: string;
  /** Carica banner cookie (Iubenda) e Google Analytics solo dopo che la pagina
   *  e' stata disegnata. Da usare SOLO su pagine senza iframe/video incorporati
   *  (YouTube, Vimeo, mappe), che altrimenti partirebbero prima del consenso. */
  deferConsent?: boolean;
  /** Pagina da non far comparire su Google (es. pagina di ringraziamento). */
  noindex?: boolean;
}
 
const {
  title = "Jam Session APS",
  description = "Scuola di canto e musica a Bologna. Corsi di canto, pianoforte, chitarra, DJ e molto altro. Sede d'esame Trinity College London.",
  lang = "it",
  image = "/assets/social/og-image.jpg",
  preloadImage,
  deferConsent = false,
  noindex = false,
} = Astro.props;
 
const SITE_NAME = "Jam Session APS";

const DEFERRED_CONSENT_JS = `(function () {
  function add(src, onload) {
    var s = document.createElement('script');
    s.src = src; s.async = false;
    if (onload) s.onload = onload;
    document.head.appendChild(s);
  }
  function start() {
    add('https://cs.iubenda.com/autoblocking/1599914.js', function () {
      add('https://cdn.iubenda.com/cs/iubenda_cs.js');
      add('https://www.googletagmanager.com/gtag/js?id=G-TLPSFHLYV2');
    });
  }
  if (document.readyState === 'complete') start();
  else window.addEventListener('load', start);
})();`;
const pageTitle = title.includes(SITE_NAME) ? title : `${title} • ${SITE_NAME}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site);
---
 
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />

  <!-- Iubenda Cookie Solution: banner di consenso, deve caricare il prima possibile -->
  <script type="text/javascript" set:html={`
    var _iub = _iub || [];
    _iub.csConfiguration = {"siteId":1599914,"cookiePolicyId":74857805,"lang":"it"};
  `} />
  {/* Pagina leggera (deferConsent): Iubenda e Google Analytics partono appena la pagina
       e' disegnata. Ordine garantito: prima il blocco preventivo di Iubenda, poi banner e
       Google. Se il blocco preventivo non si carica, Google non viene caricato affatto. */}
  {deferConsent && <script is:inline set:html={DEFERRED_CONSENT_JS} />}
  {!deferConsent && <script type="text/javascript" src="https://cs.iubenda.com/autoblocking/1599914.js"></script>}
  {!deferConsent && <script type="text/javascript" src="//cdn.iubenda.com/cs/iubenda_cs.js" charset="UTF-8" async></script>}

  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <title>{pageTitle}</title>
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
 
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content={lang === "it" ? "it_IT" : "en_GB"} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={imageURL} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={imageURL} />
 
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  {preloadImage && (
    <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
  )}
 
  <style is:global>
    @font-face {
      font-family: "Inter";
      font-style: normal;
      font-weight: 700 900;
      font-display: optional;
      src: url("/fonts/inter-700-800-900-latin.woff2") format("woff2");
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    @font-face {
      font-family: "Lexend";
      font-style: normal;
      font-weight: 300 600;
      font-display: optional;
      src: url("/fonts/lexend-300-400-500-600-latin.woff2") format("woff2");
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    body {
      margin: 0;
      font-family: "Lexend", system-ui, sans-serif;
      color: #0b0b0b;
      background: #fff;
    }
    /* Evita che l'ultima riga di un paragrafo lasci una singola parola isolata ("vedova") */
    p, li, blockquote {
      text-wrap: pretty;
    }
  </style>
  <!-- Google tag (gtag.js) -->
  {!deferConsent && <script async src="https://www.googletagmanager.com/gtag/js?id=G-TLPSFHLYV2"></script>}
  {/* is:inline: gtag deve essere una funzione globale, altrimenti gli eventi non partono */}
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-TLPSFHLYV2');
    gtag('config', 'AW-10977779327');
  </script>
  <!-- Tracciamento contatti.
       - Analytics registra i clic su "Richiedi info", WhatsApp, telefono ed email
         (eventi click_richiedi_info, click_whatsapp, click_telefono, click_email).
       - Google Ads: il tap sul cellulare resta una conversione (tap_numero_cell).
       - La conversione vera del modulo "Richiedi info" NON e' il clic: si registra
         sulla pagina /grazie, dove Jotform porta le persone dopo l'invio. -->
  <script is:inline>
    document.addEventListener('click', function (e) {
      var link = e.target.closest && e.target.closest('a[href]');
      if (!link || typeof gtag !== 'function') return;
      var href = link.getAttribute('href') || '';
      var dove = location.pathname;
      if (href.indexOf('https://form.jotform.com/262432547070049') === 0) {
        gtag('event', 'click_richiedi_info', { pagina: dove });
      } else if (href.indexOf('https://wa.me/') === 0) {
        gtag('event', 'click_whatsapp', { pagina: dove });
      } else if (href.indexOf('tel:') === 0) {
        gtag('event', 'click_telefono', { pagina: dove });
        if (href.indexOf('tel:+393202244932') === 0) {
          gtag('event', 'conversion', { 'send_to': 'AW-10977779327/WlsyCJzzrIMdEP-8zvIo' });
        }
      } else if (href.indexOf('mailto:') === 0) {
        gtag('event', 'click_email', { pagina: dove });
      }
    });
  </script>
</head>
<body>
  <slot />
</body>
</html>
