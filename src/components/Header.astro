---
const MENU = [
  {
    label: "Associazione",
    children: [
      { label: "Chi Siamo", href: "/associazione/chi-siamo" },
      { label: "Organigramma", href: "/associazione/organigramma" },
      { label: "Agevolazioni & Sostienici", href: "/associazione/agevolazioni-sostienici" },
      { label: "Documenti Utili", href: "/associazione/documenti-utili" },
    ],
  },
  { label: "Corsi", href: "/corsi" },
  { label: "Docenti", href: "/docenti" },
  { label: "Progetti", href: "/progetti" },
  { label: "Eventi", href: "/eventi" },
  { label: "European", href: "/european-partners" },
  { label: "Contatti", href: "/contatti" },
];
---

<header class="site-header">
  <div class="header-inner">

    <a class="brand" href="/">
      <div class="logo">
        <img src="/assets/logo-jam-session-registrato.png" alt="Jam Session APS - Marchio registrato" />
      </div>
      <div class="brand-name">
        Jam Session APS
        <small>Scuola di Canto e Musica</small>
      </div>
    </a>

    <nav class="nav-desktop" aria-label="Menu principale">
      {MENU.map(item => (
        item.children ? (
          <div class="nav-item has-dropdown">
            <button class="nav-link dropdown-trigger" aria-haspopup="true" aria-expanded="false">
              {item.label}
              <span class="chevron" aria-hidden="true"></span>
            </button>
            <div class="dropdown">
              {item.children.map(child => <a href={child.href}>{child.label}</a>)}
            </div>
          </div>
        ) : (
          <a class="nav-link" href={item.href}>{item.label}</a>
        )
      ))}
    </nav>

    <div class="header-right">
      <a class="top-cta" href="/contatti">Richiedi info</a>
      <button class="hamburger" aria-label="Apri menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

  </div>

  <nav class="nav-mobile" aria-label="Menu mobile">
    {MENU.map(item => (
      item.children ? (
        <div class="mobile-item has-children">
          <button class="mobile-link accordion-trigger" aria-expanded="false">
            {item.label}
            <span class="chevron" aria-hidden="true"></span>
          </button>
          <div class="mobile-submenu">
            {item.children.map(child => <a class="mobile-sublink" href={child.href}>{child.label}</a>)}
          </div>
        </div>
      ) : (
        <a class="mobile-link" href={item.href}>{item.label}</a>
      )
    ))}
    <a class="nav-mobile-cta" href="/contatti">Richiedi info</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 999;
    background: rgba(255,255,255,.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(11,11,11,.08);
  }
  .header-inner {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
    padding: 12px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }
  .logo {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
  }
  .logo img { width: 100%; height: 100%; object-fit: contain; }
  .brand-name {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 17px;
    line-height: 1.1;
  }
  .brand-name small {
    display: block;
    font-size: 11px;
    font-weight: 600;
    opacity: .7;
    margin-top: 2px;
  }
  .nav-desktop {
    display: none;
    align-items: center;
    gap: 20px;
  }
  .nav-link {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 14px;
    text-decoration: none;
    color: inherit;
    opacity: .85;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .nav-link:hover { opacity: 1; text-decoration: underline; }
  .dropdown-trigger:hover { text-decoration: none; }

  .nav-item { position: relative; }
  .chevron {
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    margin-top: -3px;
    transition: transform .18s ease;
  }
  .nav-item.open .chevron,
  .nav-item:hover .chevron {
    transform: rotate(225deg);
    margin-top: 3px;
  }

  .dropdown {
    position: absolute;
    top: calc(100% + 14px);
    left: 0;
    min-width: 230px;
    background: #fff;
    border-radius: 14px;
    border: 1px solid rgba(11,11,11,.1);
    box-shadow: 0 12px 28px rgba(11,11,11,.12);
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity .18s ease, transform .18s ease, visibility .18s ease;
    pointer-events: none;
    z-index: 30;
  }
  .nav-item:hover .dropdown,
  .nav-item.open .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }
  .dropdown a {
    font-family: "Inter", sans-serif;
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    color: #0b0b0b;
    padding: 10px 12px;
    border-radius: 8px;
    white-space: nowrap;
  }
  .dropdown a:hover { background: #f2f3f1; }

  .header-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .top-cta {
    padding: 9px 16px;
    border-radius: 999px;
    background: #f2a844;
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 13px;
    text-decoration: none;
    color: #1b1b1b;
    white-space: nowrap;
  }
  .hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: #0b0b0b;
    border-radius: 2px;
    transition: all .2s ease;
  }
  .nav-mobile {
    display: none;
    flex-direction: column;
    padding: 16px;
    border-top: 1px solid rgba(11,11,11,.08);
    background: #fff;
  }
  .mobile-link {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 18px;
    padding: 12px 0;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid rgba(11,11,11,.06);
    background: none;
    border-left: none;
    border-right: none;
    border-top: none;
    width: 100%;
    text-align: left;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
  }
  .mobile-submenu {
    display: none;
    flex-direction: column;
    padding: 4px 0 10px 14px;
  }
  .mobile-item.open .mobile-submenu { display: flex; }
  .mobile-sublink {
    font-family: "Inter", sans-serif;
    font-weight: 700;
    font-size: 16px;
    padding: 10px 0;
    text-decoration: none;
    color: inherit;
    opacity: .8;
  }
  .nav-mobile-cta {
    margin-top: 14px;
    text-align: center;
    background: #f2a844;
    border-radius: 999px;
    padding: 14px !important;
    border-bottom: none !important;
  }
  .nav-mobile.open { display: flex; }

  @media (min-width: 768px) {
    .nav-desktop { display: flex; }
    .hamburger { display: none; }
  }
</style>

<script>
  const btn = document.querySelector('.hamburger');
  const nav = document.querySelector('.nav-mobile');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });

  document.querySelectorAll('.nav-item.has-dropdown').forEach((item) => {
    const trigger = item.querySelector('.dropdown-trigger');
    trigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = item.classList.toggle('open');
      trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      document.querySelectorAll('.nav-item.has-dropdown').forEach((other) => {
        if (other !== item) {
          other.classList.remove('open');
          other.querySelector('.dropdown-trigger')?.setAttribute('aria-expanded', 'false');
        }
      });
    });
  });
  document.addEventListener('click', () => {
    document.querySelectorAll('.nav-item.has-dropdown.open').forEach((item) => {
      item.classList.remove('open');
      item.querySelector('.dropdown-trigger')?.setAttribute('aria-expanded', 'false');
    });
  });

  document.querySelectorAll('.mobile-item.has-children').forEach((item) => {
    const trigger = item.querySelector('.accordion-trigger');
    trigger?.addEventListener('click', () => {
      const isOpen = item.classList.toggle('open');
      trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  });
</script>