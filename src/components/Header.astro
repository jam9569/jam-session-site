---
const MENU = [
  {
    label: "Associazione",
    children: [
      { label: "Chi Siamo", href: "/associazione/chi-siamo" },
      { label: "Organigramma", href: "/associazione/organigramma" },
      { label: "Agevolazioni & Sostienici", href: "/associazione/agevolazioni-sostienici" },
      { label: "Documenti & App", href: "/associazione/documenti-utili" },
    ],
  },
  {
    label: "Corsi",
    children: [
      { label: "Canto", href: "/corsi/canto" },
      { label: "Chitarra e Basso", href: "/corsi/chitarra-e-basso" },
      { label: "Pianoforte e Tastiere", href: "/corsi/pianoforte-e-tastiere" },
      { label: "Batteria e Percussioni", href: "/corsi/batteria-e-percussioni" },
      { label: "Fiati", href: "/corsi/fiati" },
      { label: "Archi", href: "/corsi/archi" },
      { label: "DJ e Produzione", href: "/corsi/dj-e-produzione" },
      { label: "Musica d'insieme", href: "/corsi/musica-dinsieme" },
      { label: "Band Coaching", href: "/corsi/band-coaching" },
      { label: "Laboratorio Propedeutica 3-6 anni", href: "/corsi/laboratorio-propedeutica-3-6-anni" },
      { label: "Laboratorio di Improvvisazione e Jam Session", href: "/corsi/laboratorio-improvvisazione-e-jam-session" },
      { label: "Tutti i corsi", href: "/corsi" },
    ],
  },
  { label: "Certificazioni", href: "/certificazioni" },
  {
    label: "Progetti",
    children: [
      { label: "Musica e Società", href: "/progetti/musica-e-societa" },
      { label: "Coro di Periferia", href: "/progetti/coro-di-periferia" },
      { label: "Nausica", href: "/progetti/nausica" },
      { label: 'Borsa di Studio "Giovanni Sisillo"', href: "/progetti/borsa-di-studio-giovanni-sisillo" },
      { label: "Incubatore Orchestrale", href: "/progetti/incubatore-orchestrale" },
      { label: "Musa", href: "/progetti/musa" },
      { label: "Tutti i progetti", href: "/progetti" },
      { label: "Progetti passati", href: "/progetti/passati" },
    ],
  },
  {
    label: "Eventi",
    children: [
      { label: "Voglio Live 2027", href: "/eventi/voglio-live-2027" },
      { label: "Tutti gli eventi", href: "/eventi" },
      { label: "Eventi passati", href: "/eventi/passati" },
    ],
  },
  { label: "News", href: "/news" },
  { label: "European", href: "/european-partners" },
  { label: "Contatti", href: "/contatti" },
];
---
 
<header class="site-header">
  <div class="header-inner">
 
    <a class="brand" href="/">
      <div class="logo">
        <img src="/assets/logo-jam-session-registrato.png" alt="Jam Session APS - Marchio registrato" />
      </div>
      <div class="brand-name">
        Jam Session APS
        <small>Scuola di Canto e Musica</small>
      </div>
    </a>
 
    <nav class="nav-desktop" aria-label="Menu principale">
      {MENU.map(item => (
        item.children ? (
          <div class="nav-item has-dropdown">
            <button class="nav-link dropdown-trigger" aria-haspopup="true" aria-expanded="false">
              {item.label}
              <span class="chevron" aria-hidden="true"></span>
            </button>
            <div class="dropdown">
              {item.children.map(child => <a href={child.href}>{child.label}</a>)}
            </div>
          </div>
        ) : (
          <a class="nav-link" href={item.href}>{item.label}</a>
        )
      ))}
    </nav>
 
    <div class="header-right">
      <button class="search-trigger" aria-label="Cerca nel sito">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.2" y2="16.2"></line>
        </svg>
      </button>
      <a class="top-cta" href="https://form.jotform.com/262432547070049" target="_blank" rel="noopener">Richiedi info</a>
      <button class="hamburger" aria-label="Apri menu" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
 
  </div>
 
  <nav class="nav-mobile" aria-label="Menu mobile">
    {MENU.map(item => (
      item.children ? (
        <div class="mobile-item has-children">
          <button class="mobile-link accordion-trigger" aria-expanded="false">
            {item.label}
            <span class="chevron" aria-hidden="true"></span>
          </button>
          <div class="mobile-submenu">
            {item.children.map(child => <a class="mobile-sublink" href={child.href}>{child.label}</a>)}
          </div>
        </div>
      ) : (
        <a class="mobile-link" href={item.href}>{item.label}</a>
      )
    ))}
    <a class="nav-mobile-cta" href="https://form.jotform.com/262432547070049" target="_blank" rel="noopener">Richiedi info</a>
  </nav>

  <div class="search-overlay" role="dialog" aria-modal="true" aria-label="Cerca nel sito">
    <div class="search-panel">
      <div class="search-field">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.2" y2="16.2"></line>
        </svg>
        <input type="text" class="search-input" placeholder="Cerca corsi, progetti, news..." autocomplete="off" />
        <button class="search-close" aria-label="Chiudi ricerca">&times;</button>
      </div>
      <div class="search-results" aria-live="polite"></div>
    </div>
  </div>
</header>
 
<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 999;
    background: rgba(255,255,255,.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(11,11,11,.08);
  }
  .header-inner {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
    padding: 12px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: inherit;
  }
  .logo {
    width: 52px;
    height: 52px;
    flex-shrink: 0;
  }
  .logo img { width: 100%; height: 100%; object-fit: contain; }
  .brand-name {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 17px;
    line-height: 1.1;
  }
  .brand-name small {
    display: block;
    font-size: 11px;
    font-weight: 600;
    opacity: .7;
    margin-top: 2px;
  }
  .nav-desktop {
    display: none;
    align-items: center;
    gap: 20px;
  }
  .nav-link {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 14px;
    text-decoration: none;
    color: inherit;
    opacity: .85;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .nav-link:hover { opacity: 1; text-decoration: underline; }
  .dropdown-trigger:hover { text-decoration: none; }
 
  .nav-item { position: relative; }
  .chevron {
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    margin-top: -3px;
    transition: transform .18s ease;
  }
  .nav-item.open .chevron,
  .nav-item:hover .chevron {
    transform: rotate(225deg);
    margin-top: 3px;
  }
 
  .dropdown {
    position: absolute;
    top: calc(100% + 14px);
    left: 0;
    min-width: 230px;
    background: #fff;
    border-radius: 14px;
    border: 1px solid rgba(11,11,11,.1);
    box-shadow: 0 12px 28px rgba(11,11,11,.12);
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity .18s ease, transform .18s ease, visibility .18s ease;
    pointer-events: none;
    z-index: 30;
  }
  .nav-item:hover .dropdown,
  .nav-item.open .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }
  .dropdown a {
    font-family: "Inter", sans-serif;
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
    color: #0b0b0b;
    padding: 10px 12px;
    border-radius: 8px;
    white-space: nowrap;
  }
  .dropdown a:hover { background: #f2f3f1; }
 
  .header-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .top-cta {
    padding: 9px 16px;
    border-radius: 999px;
    background: #f2a844;
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 13px;
    text-decoration: none;
    color: #1b1b1b;
    white-space: nowrap;
  }
  .hamburger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .hamburger span {
    display: block;
    width: 22px;
    height: 2px;
    background: #0b0b0b;
    border-radius: 2px;
    transition: all .2s ease;
  }
  .nav-mobile {
    display: none;
    flex-direction: column;
    padding: 16px;
    border-top: 1px solid rgba(11,11,11,.08);
    background: #fff;
  }
  .mobile-link {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 18px;
    padding: 12px 0;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid rgba(11,11,11,.06);
    background: none;
    border-left: none;
    border-right: none;
    border-top: none;
    width: 100%;
    text-align: left;
    display: flex;
    align-items: center;
    justify-content: space-between;
    cursor: pointer;
  }
  .mobile-submenu {
    display: none;
    flex-direction: column;
    padding: 4px 0 10px 14px;
  }
  .mobile-item.open .mobile-submenu { display: flex; }
  .mobile-sublink {
    font-family: "Inter", sans-serif;
    font-weight: 700;
    font-size: 16px;
    padding: 10px 0;
    text-decoration: none;
    color: inherit;
    opacity: .8;
  }
  .nav-mobile-cta {
    margin-top: 14px;
    text-align: center;
    background: #f2a844;
    border-radius: 999px;
    padding: 14px !important;
    border-bottom: none !important;
  }
  .nav-mobile.open { display: flex; }
 
  @media (min-width: 768px) {
    .nav-desktop { display: flex; }
    .hamburger { display: none; }
  }
</style>

<style is:global>
  .search-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    background: none;
    border: 1px solid rgba(11,11,11,.14);
    color: #0b0b0b;
    cursor: pointer;
    flex-shrink: 0;
  }
  .search-trigger:hover { background: #f2f3f1; }

  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 1200;
    background: rgba(11,11,11,.5);
    display: none;
    align-items: flex-start;
    justify-content: center;
    padding: 80px 16px 16px;
  }
  .search-overlay.open { display: flex; }
  .search-panel {
    width: min(620px, 100%);
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 24px 60px rgba(0,0,0,.28);
    overflow: hidden;
  }
  .search-field {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 18px 20px;
    border-bottom: 1px solid rgba(11,11,11,.1);
  }
  .search-field svg { flex-shrink: 0; opacity: .55; }
  .search-input {
    flex: 1;
    border: none;
    outline: none;
    font-family: "Lexend", sans-serif;
    font-size: 17px;
    color: #0b0b0b;
    background: none;
  }
  .search-close {
    background: none;
    border: none;
    font-size: 24px;
    line-height: 1;
    color: #0b0b0b;
    opacity: .5;
    cursor: pointer;
    padding: 0 2px;
  }
  .search-close:hover { opacity: 1; }
  .search-results {
    max-height: min(60vh, 480px);
    overflow-y: auto;
    padding: 8px;
  }
  .search-result {
    display: block;
    padding: 12px 12px;
    border-radius: 12px;
    text-decoration: none;
    color: inherit;
  }
  .search-result:hover { background: #f2f3f1; }
  .search-result-cat {
    display: inline-block;
    font-family: "Inter", sans-serif;
    font-weight: 800;
    font-size: 11px;
    letter-spacing: .3px;
    text-transform: uppercase;
    color: #0f5f53;
    margin-bottom: 3px;
  }
  .search-result-title {
    display: block;
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 15px;
  }
  .search-result-excerpt {
    display: block;
    margin-top: 3px;
    font-family: "Lexend", sans-serif;
    font-size: 13px;
    opacity: .68;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .search-empty, .search-hint {
    padding: 24px 16px;
    text-align: center;
    font-family: "Lexend", sans-serif;
    font-size: 14px;
    opacity: .6;
  }

</style>
 
<script>
  const btn = document.querySelector('.hamburger');
  const nav = document.querySelector('.nav-mobile');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
 
  document.querySelectorAll('.nav-item.has-dropdown').forEach((item) => {
    const trigger = item.querySelector('.dropdown-trigger');
    trigger?.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = item.classList.toggle('open');
      trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      document.querySelectorAll('.nav-item.has-dropdown').forEach((other) => {
        if (other !== item) {
          other.classList.remove('open');
          other.querySelector('.dropdown-trigger')?.setAttribute('aria-expanded', 'false');
        }
      });
    });
  });
  document.addEventListener('click', () => {
    document.querySelectorAll('.nav-item.has-dropdown.open').forEach((item) => {
      item.classList.remove('open');
      item.querySelector('.dropdown-trigger')?.setAttribute('aria-expanded', 'false');
    });
  });
 
  document.querySelectorAll('.mobile-item.has-children').forEach((item) => {
    const trigger = item.querySelector('.accordion-trigger');
    trigger?.addEventListener('click', () => {
      const isOpen = item.classList.toggle('open');
      trigger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  });

  // Ricerca nel sito
  const searchTrigger = document.querySelector('.search-trigger');
  const searchOverlay = document.querySelector('.search-overlay');
  const searchInput = document.querySelector('.search-input');
  const searchClose = document.querySelector('.search-close');
  const searchResults = document.querySelector('.search-results');

  let searchIndex = null;
  let searchIndexPromise = null;

  function loadSearchIndex() {
    if (!searchIndexPromise) {
      searchIndexPromise = fetch('/search-index.json')
        .then((res) => res.json())
        .then((data) => { searchIndex = data; return data; })
        .catch(() => { searchIndex = []; return []; });
    }
    return searchIndexPromise;
  }

  function renderResults(query) {
    if (!searchResults) return;
    const q = query.trim().toLowerCase();
    if (!q) {
      searchResults.innerHTML = '<div class="search-hint">Scrivi per cercare tra corsi, progetti, news e pagine del sito.</div>';
      return;
    }
    const items = (searchIndex || []).filter((item) => {
      return (
        item.title.toLowerCase().includes(q) ||
        (item.excerpt || '').toLowerCase().includes(q) ||
        (item.category || '').toLowerCase().includes(q)
      );
    }).slice(0, 30);

    if (items.length === 0) {
      searchResults.innerHTML = '<div class="search-empty">Nessun risultato per "' + query.replace(/</g, '&lt;') + '".</div>';
      return;
    }

    searchResults.innerHTML = items.map((item) => (
      '<a class="search-result" href="' + item.url + '">' +
        '<span class="search-result-cat">' + item.category + '</span>' +
        '<span class="search-result-title">' + item.title + '</span>' +
        (item.excerpt ? '<span class="search-result-excerpt">' + item.excerpt + '</span>' : '') +
      '</a>'
    )).join('');
  }

  function openSearch() {
    searchOverlay?.classList.add('open');
    renderResults('');
    loadSearchIndex().then(() => renderResults(searchInput ? searchInput.value : ''));
    window.setTimeout(() => searchInput?.focus(), 30);
    document.body.style.overflow = 'hidden';
  }

  function closeSearch() {
    searchOverlay?.classList.remove('open');
    document.body.style.overflow = '';
  }

  searchTrigger?.addEventListener('click', openSearch);
  searchClose?.addEventListener('click', closeSearch);
  searchOverlay?.addEventListener('click', (e) => {
    if (e.target === searchOverlay) closeSearch();
  });
  searchInput?.addEventListener('input', (e) => {
    renderResults(e.target.value);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && searchOverlay?.classList.contains('open')) closeSearch();
  });
</script>