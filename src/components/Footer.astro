---
const SITE = {
  name: "Jam Session APS",
  addressLine1: "Via del Perugino 6B e 6C",
  addressLine2: "40139 Bologna",
  cf: "91388650375",
  piva: "04024071203",
  email: "info@jamsessionaps.it",
  pec: "ass.jamsession@pec.it",
};
 
const SOCIAL = [
  { label: "LinkedIn", href: "https://www.linkedin.com/company/associazione-jam-session-aps-scuola-di-canto-e-musica/", key: "linkedin" },
  { label: "Facebook", href: "https://www.facebook.com/assjamsession.it/", key: "facebook" },
  { label: "Instagram", href: "https://www.instagram.com/scuoladimusicajamsession/", key: "instagram" },
  { label: "YouTube", href: "https://www.youtube.com/@canalejamsession", key: "youtube" },
];
 
const YEAR = new Date().getFullYear();
---
 
<footer aria-label="Footer">
  <div class="footer-top">
 
    <div class="fcard">
      <div class="f-title">{SITE.name}</div>
      <p class="f-text">{SITE.addressLine1}<br/>{SITE.addressLine2}</p>
      <div class="f-meta">
        <strong>CF:</strong> {SITE.cf} &nbsp;·&nbsp; <strong>P.IVA:</strong> {SITE.piva}
      </div>
      <div class="f-meta">
        <strong>Email:</strong> <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br/>
        <strong>PEC:</strong> <a href={`mailto:${SITE.pec}`}>{SITE.pec}</a>
      </div>
    </div>
 
    <div class="fcard">
      <div class="f-title">Contatti & social</div>
      <p class="f-text">Seguici: eventi, saggi, novità e vita della scuola.</p>
      <div class="socials">
        {SOCIAL.map(s => (
          <a class="social" href={s.href} aria-label={s.label} target="_blank" rel="noopener noreferrer">
            {s.key === "linkedin" && <svg viewBox="0 0 24 24"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.49 6S0 4.88 0 3.5 1.11 1 2.49 1 4.98 2.12 4.98 3.5zM0 8h5v16H0zM8 8h4.8v2.2h.07c.67-1.27 2.3-2.6 4.73-2.6C22.4 7.6 24 10.4 24 14.2V24h-5v-8.6c0-2.05-.04-4.7-2.87-4.7-2.87 0-3.31 2.24-3.31 4.55V24H8z"/></svg>}
            {s.key === "facebook" && <svg viewBox="0 0 24 24"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7h-2.4V12h2.4V9.8c0-2.4 1.4-3.8 3.6-3.8 1 0 2 .2 2 .2v2.2h-1.1c-1.1 0-1.5.7-1.5 1.4V12h2.6l-.4 2.9h-2.2v7A10 10 0 0 0 22 12z"/></svg>}
            {s.key === "instagram" && <svg viewBox="0 0 24 24"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm10 2H7a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3zm-5 3.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 0 1 12 7.5zm0 2A2.5 2.5 0 1 0 14.5 12 2.5 2.5 0 0 0 12 9.5zM17.8 6.2a1 1 0 1 1-1 1 1 1 0 0 1 1-1z"/></svg>}
            {s.key === "youtube" && <svg viewBox="0 0 24 24"><path d="M23.5 6.2a3.1 3.1 0 0 0-2.2-2.2C19.4 3.5 12 3.5 12 3.5s-7.4 0-9.3.5A3.1 3.1 0 0 0 .5 6.2 32.6 32.6 0 0 0 0 12a32.6 32.6 0 0 0 .5 5.8 3.1 3.1 0 0 0 2.2 2.2c1.9.5 9.3.5 9.3.5s7.4 0 9.3-.5a3.1 3.1 0 0 0 2.2-2.2A32.6 32.6 0 0 0 24 12a32.6 32.6 0 0 0-.5-5.8zM9.7 15.5V8.5L15.9 12z"/></svg>}
          </a>
        ))}
      </div>
    </div>
 
    <div class="fcard">
      <div class="f-title">Newsletter della scuola</div>
      <p class="f-text">Una mail ogni tanto: eventi, saggi, novità.</p>
      <form class="form" id="sib-form" data-type="subscription" action="https://d57cc9af.sibforms.com/serve/MUIFAH2F_Nruuu8v5aeui3v_E9vJG90ZJ-cJ3StOXH5MvGzJuv2SeorVH_DdKulbx7x7AEQq9nd8PjxX8Ui4bsJoOKxY9csudcPzsds52gvWAKhM7YcsEogwTKWMvSIhuRqYfbsa1JgdMOHgPQWF0QJn8-0w6Fx5HRyWNjZU1ro1DzBCr_ErHh8HElofs5mfrxcUENyn1eFzbLpl" method="post">
        <div class="sib-input sib-form-block">
          <div class="form__entry entry_block">
            <div class="form__label-row">
              <div class="entry__field">
                <input class="input" type="text" id="NOME" name="NOME" autocomplete="off" placeholder="Il tuo nome" data-required="true" required />
              </div>
            </div>
            <label class="entry__error entry__error--primary"></label>
          </div>
        </div>
        <div class="sib-input sib-form-block">
          <div class="form__entry entry_block">
            <div class="form__label-row">
              <div class="entry__field">
                <input class="input" type="text" id="EMAIL" name="EMAIL" autocomplete="off" placeholder="La tua email" data-required="true" required />
              </div>
            </div>
            <label class="entry__error entry__error--primary"></label>
          </div>
        </div>
        <input type="text" name="email_address_check" value="" style="display:none" tabindex="-1" autocomplete="off" />
        <input type="hidden" name="locale" value="it" />
        <div class="sib-form-block">
          <button class="sib-form-block__button" type="submit">
            <svg class="icon clickable__icon progress-indicator__icon sib-hide-loader-icon" viewBox="0 0 512 512">
              <path d="M460.116 373.846l-20.823-12.022c-5.541-3.199-7.54-10.159-4.663-15.874 30.137-59.886 28.343-131.652-5.386-189.946-33.641-58.394-94.896-95.833-161.827-99.676C261.028 55.961 256 50.751 256 44.352V20.309c0-6.904 5.808-12.337 12.703-11.982 83.556 4.306 160.163 50.864 202.11 123.677 42.063 72.696 44.079 162.316 6.031 236.832-3.14 6.148-10.75 8.461-16.728 5.01z" />
            </svg>
            Iscrivimi
          </button>
        </div>
        <div id="error-message" class="newsletter-message newsletter-message-error">
          La tua iscrizione non può essere convalidata.
        </div>
        <div id="success-message" class="newsletter-message newsletter-message-success">
          La tua iscrizione è avvenuta correttamente.
        </div>
      </form>
      <div class="newsletter-note">
        Niente spam. <a href="https://www.iubenda.com/privacy-policy/74857805" target="_blank" rel="noopener">Privacy</a>.
      </div>
    </div>
 
  </div>
 
  <div class="footer-cta">
    <a class="fbtn" href="https://form.jotform.com/262432547070049" target="_blank" rel="noopener">Richiedi info</a>
    <a class="fbtn fbtn-ghost" href="https://wa.me/393202244932" target="_blank" rel="noopener">Preferisci WhatsApp?</a>
  </div>
 
  <div class="footer-bottom">
    <div class="footer-links">
      <a href="/contatti">Contatti</a>
      <a href="https://form.jotform.com/262452189887069" target="_blank" rel="noopener">Lavora con noi</a>
      <a href="https://www.iubenda.com/privacy-policy/74857805" target="_blank" rel="noopener">Privacy</a>
      <a href="#" class="iubenda-cs-preferences-link">Gestisci preferenze cookie</a>
    </div>
    <div class="footer-eu">
      <a href="/european-partners"><svg class="eu-flag" viewBox="0 0 30 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
          <rect width="30" height="20" fill="#039" />
          <g fill="#fc0">
            <polygon points="15.0,1.9 15.38,2.98 16.52,3.01 15.61,3.7 15.94,4.79 15.0,4.14 14.06,4.79 14.39,3.7 13.48,3.01 14.62,2.98"/>
            <polygon points="18.25,2.77 18.63,3.85 19.77,3.88 18.86,4.57 19.19,5.67 18.25,5.01 17.31,5.67 17.64,4.57 16.73,3.88 17.87,3.85"/>
            <polygon points="20.63,5.15 21.01,6.23 22.15,6.26 21.24,6.95 21.57,8.04 20.63,7.39 19.69,8.04 20.02,6.95 19.11,6.26 20.25,6.23"/>
            <polygon points="21.5,8.4 21.88,9.48 23.02,9.51 22.11,10.2 22.44,11.29 21.5,10.64 20.56,11.29 20.89,10.2 19.98,9.51 21.12,9.48"/>
            <polygon points="20.63,11.65 21.01,12.73 22.15,12.76 21.24,13.45 21.57,14.54 20.63,13.89 19.69,14.54 20.02,13.45 19.11,12.76 20.25,12.73"/>
            <polygon points="18.25,14.03 18.63,15.11 19.77,15.13 18.86,15.83 19.19,16.92 18.25,16.27 17.31,16.92 17.64,15.83 16.73,15.13 17.87,15.11"/>
            <polygon points="15.0,14.9 15.38,15.98 16.52,16.01 15.61,16.7 15.94,17.79 15.0,17.14 14.06,17.79 14.39,16.7 13.48,16.01 14.62,15.98"/>
            <polygon points="11.75,14.03 12.13,15.11 13.27,15.13 12.36,15.83 12.69,16.92 11.75,16.27 10.81,16.92 11.14,15.83 10.23,15.13 11.37,15.11"/>
            <polygon points="9.37,11.65 9.75,12.73 10.89,12.76 9.98,13.45 10.31,14.54 9.37,13.89 8.43,14.54 8.76,13.45 7.85,12.76 8.99,12.73"/>
            <polygon points="8.5,8.4 8.88,9.48 10.02,9.51 9.11,10.2 9.44,11.29 8.5,10.64 7.56,11.29 7.89,10.2 6.98,9.51 8.12,9.48"/>
            <polygon points="9.37,5.15 9.75,6.23 10.89,6.26 9.98,6.95 10.31,8.04 9.37,7.39 8.43,8.04 8.76,6.95 7.85,6.26 8.99,6.23"/>
            <polygon points="11.75,2.77 12.13,3.85 13.27,3.88 12.36,4.57 12.69,5.67 11.75,5.01 10.81,5.67 11.14,4.57 10.23,3.88 11.37,3.85"/>
          </g>
        </svg> For European Partners</a>
    </div>
  </div>
 
  <div class="copyright">© {YEAR} Jam Session APS · Sito realizzato da Marco Badini</div>
</footer>

<script is:inline>
  window.REQUIRED_CODE_ERROR_MESSAGE = 'Scegli un prefisso paese';
  window.LOCALE = 'it';
  window.EMAIL_INVALID_MESSAGE = window.SMS_INVALID_MESSAGE = "Le informazioni fornite non sono valide. Controlla il formato del campo e riprova.";
  window.REQUIRED_ERROR_MESSAGE = "Questo campo non pu\u00f2 essere lasciato vuoto. ";
  window.GENERIC_INVALID_MESSAGE = "Le informazioni fornite non sono valide. Controlla il formato del campo e riprova.";
  window.INVALID_NUMBER = "Le informazioni fornite non sono valide. Controlla il formato del campo e riprova.";
  window.INVALID_DATE = "Inserisci una data valida";
  window.REQUIRED_MULTISELECT_MESSAGE = 'Seleziona almeno 1 opzione';
  window.translation = {
    common: {
      selectedList: '{quantity} lista selezionata',
      selectedLists: '{quantity} liste selezionate',
      selectedOption: '{quantity} selezionato',
      selectedOptions: '{quantity} selezionati',
    }
  };
  var AUTOHIDE = Boolean(0);
</script>
<script is:inline defer src="https://sibforms.com/forms/end-form/build/main.js"></script>
 
<style>
  footer {
    margin-top: 130px;
    background: #0f5f53;
    border-radius: 28px;
    padding: 42px;
    border: 1px solid rgba(255,255,255,.18);
    color: #fff;
  }
  .footer-top {
    display: grid;
    gap: 22px;
  }
  .fcard {
    background: #fff;
    color: #0b0b0b;
    border: 1px solid rgba(11,11,11,.18);
    border-radius: 18px;
    padding: 22px;
  }
  .f-title {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 16px;
    margin: 0 0 10px;
  }
  .f-text {
    margin: 0 0 10px;
    opacity: .85;
    font-size: 14px;
    line-height: 1.45;
  }
  .f-meta {
    font-size: 13px;
    line-height: 1.6;
    opacity: .9;
  }
  .f-meta a { color: inherit; text-decoration: underline; }
  .socials { display: flex; gap: 10px; margin-top: 12px; flex-wrap: wrap; }
  .social {
    width: 40px; height: 40px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #f6f7f7;
    border: 1px solid rgba(11,11,11,.12);
    color: #0b4b42;
  }
  .social svg { width: 18px; height: 18px; fill: currentColor; }
  .form { display: grid; gap: 10px; margin-top: 12px; }
  .form input {
    padding: 12px 14px;
    border-radius: 14px;
    border: 1px solid rgba(11,11,11,.18);
    font-family: "Lexend", sans-serif;
    font-size: 14px;
  }
  .form button {
    padding: 12px 16px;
    border-radius: 999px;
    border: none;
    background: #f2a844;
    color: #1b1b1b;
    font-family: "Inter", sans-serif;
    font-weight: 900;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  .form button svg { width: 16px; height: 16px; fill: currentColor; flex-shrink: 0; }
  .form button svg.sib-hide-loader-icon { display: none; }
  .form .entry__error {
    display: block;
    font-family: "Lexend", sans-serif;
    font-size: 12px;
    color: #b3261e;
    margin: 2px 0 0;
  }
  .form .entry__error:empty { display: none; margin: 0; }
  .newsletter-message {
    display: none;
    font-family: "Lexend", sans-serif;
    font-size: 13px;
    line-height: 1.4;
    padding: 10px 12px;
    border-radius: 12px;
  }
  .newsletter-message.sib-form-message-panel--active { display: block; }
  .newsletter-message-success { background: #e7faf0; color: #085229; }
  .newsletter-message-error { background: #ffeded; color: #661d1d; }
  .newsletter-note { margin-top: 10px; font-size: 12px; opacity: .72; }
  .newsletter-note a { color: inherit; }
  .footer-cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
  .fbtn {
    display: inline-flex;
    align-items: center;
    padding: 12px 16px;
    border-radius: 999px;
    font-family: "Inter", sans-serif;
    font-weight: 900;
    background: #fff;
    color: #0b4b42;
    border: 1px solid rgba(255,255,255,.30);
    text-decoration: none;
  }
  .fbtn-ghost {
    background: rgba(255,255,255,.10);
    color: #fff;
  }
  .footer-bottom {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    margin-top: 18px;
    flex-wrap: wrap;
  }
  .footer-links { display: flex; flex-wrap: wrap; gap: 14px; }
  .footer-links a {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 13px;
    color: rgba(255,255,255,.96);
    text-decoration: none;
  }
  .footer-eu {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 13px;
  }
  .footer-eu a {
    color: rgba(255,255,255,.96);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .eu-flag {
    width: 30px;
    height: 20px;
    flex-shrink: 0;
    border-radius: 5px;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgba(255,255,255,.3), 0 2px 5px rgba(0,0,0,.35);
  }
  .copyright { margin-top: 14px; font-size: 12px; opacity: .9; }
 
  @media (min-width: 768px) {
    .footer-top { grid-template-columns: 1fr 1fr 1.2fr; }
  }
</style>