---
const SITE = {
  name: "Jam Session APS",
  addressLine1: "Via del Perugino 6B e 6C",
  addressLine2: "40139 Bologna",
  cf: "91388650375",
  piva: "04024071203",
  email: "info@assjamsession.it",
  pec: "ass.jamsession@pec.it",
};
 
const SOCIAL = [
  { label: "LinkedIn", href: "#", key: "linkedin" },
  { label: "Facebook", href: "#", key: "facebook" },
  { label: "Instagram", href: "#", key: "instagram" },
  { label: "YouTube", href: "#", key: "youtube" },
];
 
const YEAR = new Date().getFullYear();
---
 
<footer aria-label="Footer">
  <div class="footer-top">
 
    <div class="fcard">
      <div class="f-title">{SITE.name}</div>
      <p class="f-text">{SITE.addressLine1}<br/>{SITE.addressLine2}</p>
      <div class="f-meta">
        <strong>CF:</strong> {SITE.cf} &nbsp;·&nbsp; <strong>P.IVA:</strong> {SITE.piva}
      </div>
      <div class="f-meta">
        <strong>Email:</strong> <a href={`mailto:${SITE.email}`}>{SITE.email}</a><br/>
        <strong>PEC:</strong> <a href={`mailto:${SITE.pec}`}>{SITE.pec}</a>
      </div>
    </div>
 
    <div class="fcard">
      <div class="f-title">Contatti & social</div>
      <p class="f-text">Seguici: eventi, saggi, novità e vita della scuola.</p>
      <div class="socials">
        {SOCIAL.map(s => (
          <a class="social" href={s.href} aria-label={s.label}>
            {s.key === "linkedin" && <svg viewBox="0 0 24 24"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.49 6S0 4.88 0 3.5 1.11 1 2.49 1 4.98 2.12 4.98 3.5zM0 8h5v16H0zM8 8h4.8v2.2h.07c.67-1.27 2.3-2.6 4.73-2.6C22.4 7.6 24 10.4 24 14.2V24h-5v-8.6c0-2.05-.04-4.7-2.87-4.7-2.87 0-3.31 2.24-3.31 4.55V24H8z"/></svg>}
            {s.key === "facebook" && <svg viewBox="0 0 24 24"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7h-2.4V12h2.4V9.8c0-2.4 1.4-3.8 3.6-3.8 1 0 2 .2 2 .2v2.2h-1.1c-1.1 0-1.5.7-1.5 1.4V12h2.6l-.4 2.9h-2.2v7A10 10 0 0 0 22 12z"/></svg>}
            {s.key === "instagram" && <svg viewBox="0 0 24 24"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm10 2H7a3 3 0 0 0-3 3v10a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V7a3 3 0 0 0-3-3zm-5 3.5A4.5 4.5 0 1 1 7.5 12 4.5 4.5 0 0 1 12 7.5zm0 2A2.5 2.5 0 1 0 14.5 12 2.5 2.5 0 0 0 12 9.5zM17.8 6.2a1 1 0 1 1-1 1 1 1 0 0 1 1-1z"/></svg>}
            {s.key === "youtube" && <svg viewBox="0 0 24 24"><path d="M23.5 6.2a3.1 3.1 0 0 0-2.2-2.2C19.4 3.5 12 3.5 12 3.5s-7.4 0-9.3.5A3.1 3.1 0 0 0 .5 6.2 32.6 32.6 0 0 0 0 12a32.6 32.6 0 0 0 .5 5.8 3.1 3.1 0 0 0 2.2 2.2c1.9.5 9.3.5 9.3.5s7.4 0 9.3-.5a3.1 3.1 0 0 0 2.2-2.2A32.6 32.6 0 0 0 24 12a32.6 32.6 0 0 0-.5-5.8zM9.7 15.5V8.5L15.9 12z"/></svg>}
          </a>
        ))}
      </div>
    </div>
 
    <div class="fcard">
      <div class="f-title">Newsletter della scuola</div>
      <p class="f-text">Una mail ogni tanto: eventi, saggi, novità.</p>
      <form class="form" action="#" method="post">
        <input type="email" name="email" placeholder="La tua email" required />
        <button type="submit">Iscrivimi</button>
      </form>
      <div class="newsletter-note">
        Niente spam. <a href="/privacy">Privacy</a>.
      </div>
    </div>
 
  </div>
 
  <div class="footer-cta">
    <a class="fbtn" href="https://form.jotform.com/262432547070049" target="_blank" rel="noopener">Richiedi info</a>
    <a class="fbtn fbtn-ghost" href="https://wa.me/393202244932" target="_blank" rel="noopener">Preferisci WhatsApp?</a>
  </div>
 
  <div class="footer-bottom">
    <div class="footer-links">
      <a href="/contatti">Contatti</a>
      <a href="https://form.jotform.com/262452189887069" target="_blank" rel="noopener">Lavora con noi</a>
      <a href="/privacy">Privacy</a>
      <a href="/cookie">Cookie</a>
    </div>
    <div class="footer-eu">
      <a href="/european-partners">🇬🇧 For European Partners</a>
    </div>
  </div>
 
  <div class="copyright">© {YEAR} Jam Session APS</div>
</footer>
 
<style>
  footer {
    margin-top: 130px;
    background: #0f5f53;
    border-radius: 28px;
    padding: 42px;
    border: 1px solid rgba(255,255,255,.18);
    color: #fff;
  }
  .footer-top {
    display: grid;
    gap: 22px;
  }
  .fcard {
    background: #fff;
    color: #0b0b0b;
    border: 1px solid rgba(11,11,11,.18);
    border-radius: 18px;
    padding: 22px;
  }
  .f-title {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 16px;
    margin: 0 0 10px;
  }
  .f-text {
    margin: 0 0 10px;
    opacity: .85;
    font-size: 14px;
    line-height: 1.45;
  }
  .f-meta {
    font-size: 13px;
    line-height: 1.6;
    opacity: .9;
  }
  .f-meta a { color: inherit; text-decoration: underline; }
  .socials { display: flex; gap: 10px; margin-top: 12px; flex-wrap: wrap; }
  .social {
    width: 40px; height: 40px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #f6f7f7;
    border: 1px solid rgba(11,11,11,.12);
    color: #0b4b42;
  }
  .social svg { width: 18px; height: 18px; fill: currentColor; }
  .form { display: grid; gap: 10px; margin-top: 12px; }
  .form input {
    padding: 12px 14px;
    border-radius: 14px;
    border: 1px solid rgba(11,11,11,.18);
    font-family: "Lexend", sans-serif;
    font-size: 14px;
  }
  .form button {
    padding: 12px 16px;
    border-radius: 999px;
    border: none;
    background: #f2a844;
    color: #1b1b1b;
    font-family: "Inter", sans-serif;
    font-weight: 900;
    cursor: pointer;
  }
  .newsletter-note { margin-top: 10px; font-size: 12px; opacity: .72; }
  .newsletter-note a { color: inherit; }
  .footer-cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
  .fbtn {
    display: inline-flex;
    align-items: center;
    padding: 12px 16px;
    border-radius: 999px;
    font-family: "Inter", sans-serif;
    font-weight: 900;
    background: #fff;
    color: #0b4b42;
    border: 1px solid rgba(255,255,255,.30);
    text-decoration: none;
  }
  .fbtn-ghost {
    background: rgba(255,255,255,.10);
    color: #fff;
  }
  .footer-bottom {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 18px;
    margin-top: 18px;
    flex-wrap: wrap;
  }
  .footer-links { display: flex; flex-wrap: wrap; gap: 14px; }
  .footer-links a {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 13px;
    color: rgba(255,255,255,.96);
    text-decoration: none;
  }
  .footer-eu {
    font-family: "Inter", sans-serif;
    font-weight: 900;
    font-size: 13px;
  }
  .footer-eu a { color: rgba(255,255,255,.96); text-decoration: none; }
  .copyright { margin-top: 14px; font-size: 12px; opacity: .9; }
 
  @media (min-width: 768px) {
    .footer-top { grid-template-columns: 1fr 1fr 1.2fr; }
  }
</style>